#!/usr/bin/env python3
"""derot-annotate — two labelled stills for a v3w night page (Peter, 2026-11-13:
"both images are fantastic and should be deliverables").

  sky   sky-labelled.jpg: one frame of the night's deep derot sweep, the
        one with the most galactic plane in the field, with the plane
        (b=0, and b=+-10 deg) and the bright stars named.
  hq16  hq16-in-v3w.jpg: a v3w frame near 23:00 UTC with the HQ16 field
        outlined (eclipticam-hq16/camera.json field_solve; fixed in alt-az).

Both are drawn through the night's refined camera model (skyglow-cammodel.json),
carry a 10 deg scale bar, and are privacy-cropped (<camera>/privacy.json).
Run where the frames are (muppet). Usage:

  derot-annotate sky  NIGHT [--sweep-start HH:MM --step-min 1 --window-min 10]
  derot-annotate hq16 NIGHT
"""
import argparse
import json
import os
import subprocess
import sys
import tempfile
import warnings
from datetime import timedelta
from importlib.machinery import SourceFileLoader
from pathlib import Path
from zoneinfo import ZoneInfo

import numpy as np

warnings.filterwarnings("ignore")
HERE = Path(__file__).resolve().parent
REPO = HERE.parent
os.environ.setdefault("DEROT_CAMERA", "eclipticam-v3w")
ds = SourceFileLoader("derot_sky", str(HERE / "derot-sky")).load_module()

STARS = {"Betelgeuse": (88.79, 7.41), "Rigel": (78.63, -8.20), "Bellatrix": (81.28, 6.35),
         "Saiph": (86.94, -9.67), "Orion's belt": (84.05, -1.20), "Orion Nebula": (83.82, -5.39),
         "Sirius": (101.29, -16.72), "Procyon": (114.83, 5.23), "Aldebaran": (68.98, 16.51),
         "Pollux": (116.33, 28.03), "Castor": (113.65, 31.89), "Pleiades": (56.75, 24.12),
         "Capella": (79.17, 46.00), "Regulus": (152.09, 11.97), "Fomalhaut": (344.41, -29.62),
         "Altair": (297.70, 8.87), "Vega": (279.23, 38.78), "Deneb": (310.36, 45.28),
         "Antares": (247.35, -26.43), "Spica": (201.30, -11.16), "Arcturus": (213.92, 19.18),
         "Diphda": (10.90, -17.99), "Hamal": (31.79, 23.46), "Mira": (34.84, -2.98)}


def night_dir(night):
    return Path.home() / "eclipticam-frames" / "night" / night


def privacy_keep(h):
    pj = REPO / ds.CAMERA / "privacy.json"
    if not pj.exists():
        return h
    s = json.load(open(pj))
    return int(round(s["publish_keep_top_px"] * h / s["frame_size_px"][1])) // 2 * 2


def project(cm, sc, t):
    from astropy.coordinates import AltAz, EarthLocation
    from astropy.time import Time
    import astropy.units as u
    aa = sc.transform_to(AltAz(obstime=Time(t), pressure=0,
                               location=EarthLocation(lat=ds.LAT * u.deg, lon=ds.LON * u.deg)))
    v = ds._enu(np.radians(aa.az.deg), np.radians(aa.alt.deg))
    x, y = cm.project(v)
    return x, y, (v @ cm.b > 0.2) & (aa.alt.deg > 0)


def galactic(b):
    from astropy.coordinates import SkyCoord
    import astropy.units as u
    l = np.linspace(0, 360, 1441)
    return SkyCoord(l=l * u.deg, b=np.full_like(l, b) * u.deg, frame="galactic")


def finish(im, cm, title, out):
    from PIL import ImageDraw
    d = ImageDraw.Draw(im)
    d.rectangle([0, 0, im.width, 22], fill=(0, 0, 0))
    d.text((8, 5), title, fill=(255, 255, 0))
    L = cm.f * np.radians(10)            # 10 deg at the optical centre; the fisheye shrinks it outwards
    y0 = im.height - 30
    d.rectangle([20, y0 - 8, 40 + L, y0 + 22], fill=(0, 0, 0))
    d.line([30, y0, 30 + L, y0], fill=(255, 255, 255), width=3)
    d.text((30, y0 + 6), "10 deg (at centre)", fill=(255, 255, 255))
    im.save(out, quality=88)
    print(f"wrote {out} {im.size}")


def cmd_sky(a):
    from PIL import Image, ImageDraw
    from astropy.coordinates import SkyCoord
    import astropy.units as u
    nd = night_dir(a.night)
    cm = ds.CameraModel(str(nd / "skyglow-cammodel.json"))
    mp4 = nd / "sweep-derot-deep.mp4"
    n = int(subprocess.run(["ffprobe", "-v", "error", "-count_packets", "-select_streams", "v",
                            "-show_entries", "stream=nb_read_packets", "-of", "csv=p=0", str(mp4)],
                           capture_output=True, text=True, check=True).stdout.strip())
    t0 = ds.utc_on_night(a.night, a.sweep_start)
    H = privacy_keep(1296)
    W = 2304
    plane = galactic(0)
    best = None
    for i in range(0, n, 10):            # the window with the most galactic plane in the published frame
        t = t0 + timedelta(minutes=i * a.step_min + a.window_min / 2)
        x, y, ok = project(cm, plane, t)
        k = ok & (x >= 0) & (x < W) & (y >= 0) & (y < H)
        if best is None or k.sum() > best[0]:
            best = (int(k.sum()), i, t)
    _, i, t = best
    with tempfile.TemporaryDirectory() as td:
        f = Path(td) / "f.png"
        subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", str(mp4), "-vf", f"select=eq(n\\,{i})",
                        "-frames:v", "1", str(f)], check=True)
        im = Image.open(f).convert("RGB")
    d = ImageDraw.Draw(im)
    for b, col, w in [(0, (255, 140, 0), 3), (10, (180, 100, 0), 1), (-10, (180, 100, 0), 1)]:
        x, y, ok = project(cm, galactic(b), t)
        for j in range(len(x) - 1):
            if ok[j] and ok[j + 1] and abs(x[j] - x[j + 1]) < 200:
                d.line([x[j], y[j], x[j + 1], y[j + 1]], fill=col, width=w)
    sc = SkyCoord([v[0] for v in STARS.values()] * u.deg, [v[1] for v in STARS.values()] * u.deg)
    x, y, ok = project(cm, sc, t)
    for name, xi, yi, k in zip(STARS, x, y, ok):
        if k and 0 <= xi < im.width and 0 <= yi < im.height - 40:
            d.ellipse([xi - 9, yi - 9, xi + 9, yi + 9], outline=(0, 160, 255), width=2)
            d.text((xi + 11, yi - 6), name, fill=(120, 200, 255))
    loc = t.astimezone(ZoneInfo("Europe/London"))
    finish(im, cm, f"{a.night}: the deep sky at {loc:%H:%M} {loc.tzname()}. "
           "Orange: the plane of the Milky Way (thin: 10 deg either side). Blue: bright stars.",
           nd / "sky-labelled.jpg")


def cmd_hq16(a):
    from PIL import Image, ImageDraw
    from astropy.coordinates import SkyCoord, AltAz, EarthLocation
    from astropy.time import Time
    import astropy.units as u
    nd = night_dir(a.night)
    cm = ds.CameraModel(str(nd / "skyglow-cammodel.json"))
    fs = json.load(open(REPO / "eclipticam-hq16" / "camera.json")).get("field_solve")
    if not fs:
        sys.exit("eclipticam-hq16/camera.json has no field_solve")
    gm = ds.GlowModel(str(nd / "skyglow-model.npz"))
    frames = ds.clean_frames(a.night, ds.night_frames(a.night), str(nd / "skyglow-model.npz"), 1.5) \
        or ds.night_frames(a.night)
    tt = ds.utc_on_night(a.night, "23:00:00")
    dt, path = min(frames, key=lambda tp: abs((tp[0] - tt).total_seconds()))
    img = gm.subtract(ds.load_binned(path))
    lo, hi = np.percentile(img, [5, 99.8])
    a8 = (np.clip((img - lo) / (hi - lo), 0, 1) ** 0.5 * 255).astype(np.uint8)
    im = Image.fromarray(a8).convert("RGB")
    # outline: the solved field's edge in its tangent plane, to alt-az at the
    # solve time (the camera is fixed), then through the v3w model
    c = SkyCoord(fs["ra_deg"] * u.deg, fs["dec_deg"] * u.deg)
    hw, hh, pa = fs["width_deg"] / 2, fs["height_deg"] / 2, np.radians(fs["up_deg_e_of_n"])
    s = np.linspace(-1, 1, 60)
    e = np.concatenate([np.c_[s * hw, np.full(60, hh)], np.c_[np.full(60, hw), -s * hh],
                        np.c_[-s * hw, np.full(60, -hh)], np.c_[np.full(60, -hw), s * hh]])
    xi = e[:, 0] * np.cos(pa) + e[:, 1] * np.sin(pa)
    eta = -e[:, 0] * np.sin(pa) + e[:, 1] * np.cos(pa)
    pts = c.spherical_offsets_by(-xi * u.deg, eta * u.deg)
    fr = AltAz(obstime=Time(fs["utc"].rstrip("Z")), pressure=0,
               location=EarthLocation(lat=ds.LAT * u.deg, lon=ds.LON * u.deg))
    for sc, draw in ((pts, "edge"), (c, "label")):
        aa = sc.transform_to(fr)
        x, y = cm.project(ds._enu(np.radians(aa.az.deg), np.radians(aa.alt.deg)))
        d = ImageDraw.Draw(im)
        if draw == "edge":
            d.line(list(zip(x, y)) + [(x[0], y[0])], fill=(255, 220, 0), width=3)
        else:
            d.text((float(x) - 20, float(y)), "HQ16", fill=(255, 220, 0))
    im = im.crop((0, 0, im.width, privacy_keep(im.height)))
    loc = dt.astimezone(ZoneInfo("Europe/London"))
    finish(im, cm, f"{a.night}, {loc:%H:%M}: the v3 Wide's view. Yellow: where HQ16 points "
           f"({fs['width_deg']:.1f} x {fs['height_deg']:.1f} deg, solve epoch {fs['epoch']})",
           nd / "hq16-in-v3w.jpg")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("sky"); s.add_argument("night")
    s.add_argument("--sweep-start", default="22:00", help="the sweep's start, UTC (as given to derot-sky sweep)")
    s.add_argument("--step-min", type=float, default=1); s.add_argument("--window-min", type=float, default=10)
    h = sub.add_parser("hq16"); h.add_argument("night")
    a = ap.parse_args()
    {"sky": cmd_sky, "hq16": cmd_hq16}[a.cmd](a)


if __name__ == "__main__":
    main()

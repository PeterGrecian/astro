#!/usr/bin/env python3
"""xoverpi-planevid — turn an hour of plane-hunt h264 into a 6 s inspection video.

Runs on muppet, where the frames already are. Each output frame is a MAX over a
group of input frames, not a mean: a plane is a small bright object moving fast,
so averaging dilutes it into the background while max-hold keeps every position
it occupied. One transit therefore renders as a continuous streak in a single
output frame, which is the thing being looked for.

    xoverpi-planevid <in.h264> [-o out.mp4] [--seconds 6] [--fps 60]

Group size is derived, not configured: it is however many input frames must
collapse into each output frame to hit the requested duration.
"""
import argparse, subprocess, sys
from pathlib import Path
import numpy as np

AP = argparse.ArgumentParser()
AP.add_argument("src", type=Path)
AP.add_argument("-o", "--out", type=Path)
AP.add_argument("--seconds", type=float, default=6.0)
AP.add_argument("--fps", type=int, default=60)
a = AP.parse_args()

out = a.out or a.src.with_suffix(".mp4")
n_out = int(round(a.seconds * a.fps))

def probe(stream, key):
    r = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0",
                        "-show_entries", stream, "-of", "csv=p=0", str(a.src)],
                       capture_output=True, text=True)
    return r.stdout.strip().split(",")[0]

w, h = int(probe("stream=width", 0)), int(probe("stream=height", 0))
nb = probe("stream=nb_frames", 0)
total = int(nb) if nb.isdigit() else 0
if not total:                      # raw h264 often has no frame count
    r = subprocess.run(["ffprobe", "-v", "error", "-count_frames",
                        "-select_streams", "v:0", "-show_entries",
                        "stream=nb_read_frames", "-of", "csv=p=0", str(a.src)],
                       capture_output=True, text=True)
    total = int(r.stdout.strip() or 0)
if not total:
    sys.exit(f"cannot determine frame count of {a.src}")

group = max(1, total // n_out)
print(f"{a.src.name}: {w}x{h}, {total} frames -> {n_out} out, max over {group}")

dec = subprocess.Popen(
    ["ffmpeg", "-v", "error", "-i", str(a.src), "-f", "rawvideo",
     "-pix_fmt", "gray", "-"], stdout=subprocess.PIPE)
enc = subprocess.Popen(
    ["ffmpeg", "-v", "error", "-y", "-f", "rawvideo", "-pix_fmt", "gray",
     "-s", f"{w}x{h}", "-r", str(a.fps), "-i", "-",
     "-c:v", "libx264", "-preset", "medium", "-crf", "20",
     "-pix_fmt", "yuv420p", str(out)], stdin=subprocess.PIPE)

fsize = w * h
acc = None
n_in = written = 0
while written < n_out:
    buf = dec.stdout.read(fsize)
    if len(buf) < fsize:
        break
    f = np.frombuffer(buf, np.uint8).reshape(h, w)
    acc = f.copy() if acc is None else np.maximum(acc, f)
    n_in += 1
    if n_in % group == 0:
        enc.stdin.write(acc.tobytes()); written += 1; acc = None
if acc is not None and written < n_out:
    enc.stdin.write(acc.tobytes()); written += 1

enc.stdin.close(); enc.wait(); dec.stdout.close(); dec.wait()
print(f"wrote {out} ({written} frames, {written/a.fps:.1f}s at {a.fps}fps)")

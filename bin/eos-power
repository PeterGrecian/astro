#!/usr/bin/env python3
"""eos-power — off/on/cycle the EOS 2000D's 12V dummy-battery feed.

The 12V rail is the ONLY reset that clears a Class-B firmware wedge (0x2019
PTP Device Busy / -110); the camera power switch does NOT, because the
dummy-battery PSU holds the USB device alive across a switch flip (astro-canon
STATE, Reset ladder). A **Matter smart plug** switches mains to the DR-E10
dummy-battery adapter, so a wedge can be cleared remotely instead of by a human
pulling the plug. (This is strand option (b): reuse a smart mains plug rather
than a GPIO relay in the 12V line — coarser, whole-adapter, but no new
hardware. Commissioned 2026-07-26; see home-automation STATE.)

  eos-power off      # cut mains to the DR-E10 adapter (12V rail down)
  eos-power on       # restore mains (rail up)
  eos-power cycle    # off, wait --secs, on  (the STATE-validated ~10s pull)
  eos-power status   # best-effort: is the camera enumerated on muppet?

HARDWARE (Matter smart plug via HA python-matter-server WebSocket API):
  MATTER_WS   : ws:// URL of the matter-server (homepi:5580)
  MATTER_NODE : commissioned node id of the plug feeding the DR-E10 adapter
  PLUG_ON_POWERS_CAMERA : True if plug ON = mains present = camera powered
                          (normal wiring; the plug feeds the adapter directly)

If the plug can't be reached, off/on/cycle print the failure and exit non-zero,
so the recovery protocol degrades safely (logs "power-cycle unavailable" rather
than silently doing nothing).

`cycle` VERIFIES the rail actually dropped by watching the camera's USB device
number (a real power cut forces re-enumeration with a NEW Dev). Smart plugs here
have proved outrageously unreliable, and a plug that ACKs the command without
switching mains is otherwise indistinguishable from an uncurable camera wedge.
Exit codes for `cycle`:
  0  cycled and verified (Dev changed) — or --no-verify
  2  plug unreachable / command failed (the reset never ran)
  3  PLUG LIED: ACKed but Dev unchanged — suspect the plug, not the camera
  4  camera never came back on the bus after the cycle
"""
import argparse, asyncio, json, re, subprocess, sys, time

# ---- hardware config (Matter smart plug) ------------------------------------
MATTER_WS = "ws://homepi.local:5580/ws"   # HA python-matter-server WS API
MATTER_NODE = 7                           # Realwe Innovation plug (node 7)
# Plugs get replaced and renumber on re-commissioning, so prefer matching the
# vendor name and fall back to MATTER_NODE. Set to None to match by id only.
# NB match the VENDOR (0/40/1), not the product: the retired Sandstrom ghost
# still on the fabric is also called "…Smart Plug".
MATTER_VENDOR = "Realwe"                  # 0/40/1 substring, case-insensitive
PLUG_ON_POWERS_CAMERA = True              # plug ON = mains up = camera powered
ONOFF_CLUSTER = 6                         # Matter On/Off cluster id
# 90s, NOT 10s. 10s is enough to make the camera re-enumerate with a new USB
# Dev number, which is why it looked sufficient (verified 2026-07-26) — but
# re-enumeration is NOT the same as clearing a Class-B firmware wedge. Measured
# 2026-08-09 on a real 0x2019/-110 wedge: cycles at 10s, 25s and 30s each gave a
# NEW Dev number and each left config writes still rejected; only a 90s pull
# cleared it. The dummy-battery adapter's caps hold the logic rail up long after
# the USB interface has dropped. So a changed Dev proves mains fell, not that
# the camera reset — and the historical "post-cycle: STILL WEDGED" results were
# probably just too-short pulls.
CYCLE_SECS = 90

def _configured():
    return MATTER_WS is not None and MATTER_NODE is not None

async def _plug_command(cmd_name: str) -> bool:
    """Send an On/Off cluster command to the plug over the matter-server WS.
    Auto-discovers the On/Off endpoint from the node's attributes.
    """
    try:
        import websockets
    except ImportError:
        print("eos-power: python 'websockets' module not installed",
              file=sys.stderr)
        return False
    try:
        async with websockets.connect(MATTER_WS, max_size=None,
                                       open_timeout=10) as ws:
            await ws.recv()  # server info banner

            async def call(mid, command, args=None):
                p = {"message_id": str(mid), "command": command}
                if args is not None:
                    p["args"] = args
                await ws.send(json.dumps(p))
                while True:
                    m = json.loads(await asyncio.wait_for(ws.recv(), timeout=60))
                    if m.get("message_id") == str(mid):
                        return m

                # find our plug: by product name if set, else by node id
            nodes = (await call(1, "get_nodes")).get("result", [])

            def has_onoff(n):
                return any(k.endswith(f"/{ONOFF_CLUSTER}/0")
                           for k in n.get("attributes", {}))

            node = None
            if MATTER_VENDOR:
                want = MATTER_VENDOR.strip().lower()
                cands = [n for n in nodes
                         if want in str(n.get("attributes", {}).get("0/40/1",
                                                                    "")).lower()
                         and has_onoff(n)]
                # a reachable match wins over a stale ghost of an old plug
                node = next((n for n in cands if n.get("available")),
                            cands[0] if cands else None)
            if node is None:
                node = next((n for n in nodes
                             if n.get("node_id") == MATTER_NODE), None)
            if node is None:
                print(f"eos-power: no plug found (vendor {MATTER_VENDOR!r}, "
                      f"node {MATTER_NODE}) — not commissioned?",
                      file=sys.stderr)
                return False
            nid = node.get("node_id")
            if not node.get("available"):
                print(f"eos-power: plug node {nid} is commissioned but "
                      f"unavailable (offline?)", file=sys.stderr)
                return False
            ep = next((int(k.split("/")[0])
                       for k in node.get("attributes", {})
                       if k.endswith(f"/{ONOFF_CLUSTER}/0")), None)
            if ep is None:
                print(f"eos-power: node {nid} has no On/Off cluster",
                      file=sys.stderr)
                return False
            r = await call(2, "device_command",
                           {"node_id": nid, "endpoint_id": ep,
                            "cluster_id": ONOFF_CLUSTER,
                            "command_name": cmd_name, "payload": {}})
            if r.get("error_code"):
                print(f"eos-power: plug {cmd_name} failed: {r}", file=sys.stderr)
                return False
            return True
    except Exception as ex:
        print(f"eos-power: matter-server unreachable ({MATTER_WS}): {ex}",
              file=sys.stderr)
        return False

def _relay_set(powered: bool) -> bool:
    """Switch the plug so the camera is powered (True) or not (False).
    Returns True on success."""
    if not _configured():
        print(f"eos-power: plug not configured (MATTER_WS/MATTER_NODE unset) — "
              f"would set camera power {'ON' if powered else 'OFF'}",
              file=sys.stderr)
        return False
    cmd = "On" if (powered == PLUG_ON_POWERS_CAMERA) else "Off"
    return asyncio.run(_plug_command(cmd))

# ---- status (best effort, host-independent of the relay) --------------------
def camera_enumerated() -> bool:
    """Is the EOS on muppet's USB bus? (04a9:32e1). Run this ON muppet."""
    return camera_dev() is not None

def camera_dev():
    """The EOS's current (bus, device) numbers, or None if not on the bus.

    This is the GROUND TRUTH for "did the rail actually drop": a power cycle
    makes the camera re-enumerate with a NEW device number. A smart plug that
    ACKs the On/Off command but doesn't actually switch mains leaves the Dev
    number unchanged — indistinguishable from a real wedge without this check.
    (Verified by hand 2026-07-26: Dev 013->014 across a genuine cycle.)"""
    try:
        out = subprocess.run(["lsusb"], capture_output=True, text=True,
                             timeout=10).stdout
    except Exception:
        return None
    for line in out.splitlines():
        if "04a9:32e1" in line:
            m = re.match(r"Bus (\d+) Device (\d+):", line)
            if m:
                return (m.group(1), m.group(2))
            return ("?", "?")
    return None

def wait_reenumerate(before, timeout=40, poll=2):
    """Wait for the camera to come back with a DIFFERENT device number.

    Returns (ok, dev). ok=False means the rail never dropped (dev unchanged =
    the plug lied) or the camera never came back within `timeout`."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        dev = camera_dev()
        if dev is not None and dev != before:
            return True, dev
        time.sleep(poll)
    return False, camera_dev()

def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("action", choices=["off", "on", "cycle", "status"])
    ap.add_argument("--secs", type=int, default=CYCLE_SECS,
                    help="off-duration for cycle (default ~10s, STATE-validated)")
    ap.add_argument("--no-verify", dest="verify", action="store_false",
                    help="skip the Dev-number check that the rail really dropped")
    args = ap.parse_args()

    if args.action == "status":
        up = camera_enumerated()
        print(f"camera {'enumerated' if up else 'NOT on bus'}")
        sys.exit(0 if up else 1)

    if args.action == "off":
        sys.exit(0 if _relay_set(False) else 2)
    if args.action == "on":
        sys.exit(0 if _relay_set(True) else 2)
    if args.action == "cycle":
        before = camera_dev()
        ok = _relay_set(False)
        if not ok:
            sys.exit(2)
        print(f"eos-power: 12V off, waiting {args.secs}s for rail to drop…",
              flush=True)
        time.sleep(args.secs)
        ok = _relay_set(True) and ok
        print("eos-power: 12V restored", flush=True)
        if not ok:
            sys.exit(2)
        if not args.verify:
            sys.exit(0)
        if before is None:
            print("eos-power: camera was not on the bus before the cycle — "
                  "cannot verify by Dev number", file=sys.stderr)
            sys.exit(0)
        moved, dev = wait_reenumerate(before)
        if moved:
            print(f"eos-power: verified — camera re-enumerated "
                  f"Dev {before[1]} -> {dev[1]} (rail definitely dropped)")
            sys.exit(0)
        if dev == before:
            print(f"eos-power: PLUG LIED — Dev {before[1]} unchanged; the plug "
                  f"ACKed but mains never dropped. Suspect the plug, NOT the "
                  f"camera.", file=sys.stderr)
            sys.exit(3)
        print("eos-power: camera did NOT come back on the bus after the cycle",
              file=sys.stderr)
        sys.exit(4)

if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""cover — command astrocam's servo-driven lens cover from anywhere.

  cover open       # open the cover (night position)
  cover close      # close the cover (day position)
  cover status     # show the last-commanded position from cover.json

Runs on any host: if the hostname is not 'astrocam', SSHes there
transparently.  The servo is an SG90 on GPIO18, driven by cover.py
in the astrocam directory.  The last-commanded position is persisted
in /var/lib/astrocam/cover.json by the gate daemon; this tool reads
(status) or writes (open/close) that file to stay consistent.

There is NO position feedback — no switch, no encoder.  The state file
records what was COMMANDED, not what the servo actually reached.  If the
cover is physically stuck or was moved by hand, the file will be wrong.

History: this was originally a bash script for starcam's cover (retired
2026-08-02 with the camera).  Rewritten 2026-09-07 for astrocam's SG90.
"""
import argparse
import json
import os
import subprocess
import sys

ASTROCAM_HOST = "astrocam"
COVER_PY = os.path.expanduser("~/astro/astrocam/cover.py")
COVER_STATE = "/var/lib/astrocam/cover.json"


def _on_astrocam() -> bool:
    try:
        return os.uname().nodename == ASTROCAM_HOST
    except Exception:
        return False


def _ssh(cmd: str, timeout: int = 30) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["ssh", f"peter@{ASTROCAM_HOST}", cmd],
        capture_output=True, text=True, timeout=timeout,
    )


def _run_cover(position: str) -> bool:
    """Drive the servo to `position` ('open' or 'closed')."""
    if _on_astrocam():
        r = subprocess.run(
            [sys.executable, COVER_PY, position],
            capture_output=True, text=True, timeout=30,
        )
    else:
        r = _ssh(f"python3 {COVER_PY} {position}")
    if r.returncode != 0:
        print(f"cover: servo command failed: {r.stderr.strip()}", file=sys.stderr)
        return False
    return True


def _write_state(position: str) -> bool:
    """Persist the commanded position so the gate daemon stays consistent."""
    payload = json.dumps({"position": position})
    if _on_astrocam():
        try:
            from pathlib import Path
            p = Path(COVER_STATE)
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(payload)
            return True
        except OSError as e:
            print(f"cover: state write failed: {e}", file=sys.stderr)
            return False
    else:
        r = _ssh(f"mkdir -p $(dirname {COVER_STATE}) && "
                 f"printf '%s' '{payload}' > {COVER_STATE}")
        if r.returncode != 0:
            print(f"cover: remote state write failed: {r.stderr.strip()}",
                  file=sys.stderr)
            return False
        return True


def _read_state() -> str | None:
    """Read the last-commanded position, or None."""
    if _on_astrocam():
        try:
            return json.loads(open(COVER_STATE).read()).get("position")
        except (OSError, ValueError):
            return None
    else:
        r = _ssh(f"cat {COVER_STATE}")
        if r.returncode != 0:
            return None
        try:
            return json.loads(r.stdout).get("position")
        except ValueError:
            return None


def main():
    ap = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("action", choices=["open", "close", "closed", "status"],
                    help="open | close | status")
    args = ap.parse_args()

    if args.action == "status":
        pos = _read_state()
        if pos is None:
            print("cover: unknown (no state file or unreachable)")
            sys.exit(1)
        print(f"cover: last commanded = {pos}")
        sys.exit(0)

    # Normalise: accept both "close" and "closed" (the servo script wants "closed")
    position = "closed" if args.action in ("close", "closed") else "open"

    current = _read_state()
    if current == position:
        print(f"cover: already {position}")
        sys.exit(0)

    ok = _run_cover(position)
    if ok:
        _write_state(position)
        print(f"cover: {position}")
    sys.exit(0 if ok else 2)


if __name__ == "__main__":
    main()

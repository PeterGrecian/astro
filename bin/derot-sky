#!/usr/bin/env python3
"""derot-sky — de-rotate a night onto the sky with the fitted camera model.

The astrocam answer to eclipticam's detrans-deep. Instead of rotating the
image plane about a pole pixel (which smears every star away from the optical
axis, because the lens distortion is centred on the axis and not the pole),
each output pixel is a FIXED SKY DIRECTION at a reference time. For every
frame that direction is turned about the celestial pole by the sidereal angle,
projected into the frame through the camera model, and sampled. Per frame:

  * the smooth sky glow is subtracted (astro.skyglow.GlowModel, ~3 numbers);
  * foreground (trees, roof) is masked with the glow model's eroded sky mask;
  * the frame is weighted by 1 / sky level (sky-limited noise: var ~ sky);
  * frames whose glow fit is poor (cloud) or that are not astronomically
    dark are skipped.

Output is the weighted mean and the weight map, so regions seen by fewer
frames (the sky rotates ~150 deg across a long night, so only the polar cap
is in view all night) are not dimmed, just noisier.

Steps (both run on muppet, where the frames are):

  derot-sky refine CAM.json NIGHT FRAME_UTC --glow GLOW.npz -o CAM-NIGHT.json
      Predict the catalogue stars stored in CAM.json for one frame, centroid
      the real stars near each prediction in the glow-subtracted frame, and
      refit pointing (az0, alt0, roll). Camera nudges between the solve night
      and this one are absorbed here.
  derot-sky stack CAM-NIGHT.json NIGHT --glow GLOW.npz --ref-utc HH:MM:SS
      [--from HH:MM --to HH:MM (UTC)] [--max-ratio 1.5] -o OUTDIR

  derot-sky sweep CAM-NIGHT.json NIGHT --glow GLOW.npz
      [--sweep-start 22:00 --sweep-end 04:00 (UTC)] [--window-min 10 --step-min 1]
      --out-max sweep-derot.mp4 --out-deep sweep-derot-deep.mp4
      Sliding-window video, the astrocam pair to eclipticam's detrans sweeps.
      Each window is re-projected to the sky at ITS OWN centre time, so the
      video shows the sky turning with point stars. max = per-pixel MAX of the
      window's clipped samples (streak-free sweep-detrans, no aircraft or hot-pixel arcs); deep = weighted mean with a high-side
      clip (aircraft, satellites). One fixed stretch for the whole video, from
      a pre-pass over sample windows, so it does not flicker.

Writes OUTDIR/derot-sky.fits (mean, weight extensions) and a preview JPEG.
"""
from __future__ import annotations

import argparse
import glob
import json
import os
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path

import numpy as np

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from astro.skyglow import SIDEREAL_RAD_PER_S, CameraModel, GlowModel, _enu  # noqa: E402

LAT, LON = 51.3948, -0.2923
BASE = os.environ.get("BIGSTORE", "/mnt/bigstore/astro-data")


def night_frames(night):
    out = []
    for p in sorted(glob.glob(f"{BASE}/astrocam-frames/{night}/[0-2][0-9]/*.fits.fz")):
        ms = int(os.path.basename(p).split(".")[0])
        out.append((datetime.fromtimestamp(ms / 1000, timezone.utc), p))
    return sorted(out)


EXPTIME_S = 59.9   # astrocam; frame timestamp (filename = DATE-OBS) is exposure START


def mid(dt):
    return dt + timedelta(seconds=EXPTIME_S / 2)


def load_binned(path):
    from astropy.io import fits
    with fits.open(path) as h:
        d = h[1].data
    H, W = d.shape
    return d[:H // 2 * 2, :W // 2 * 2].reshape(H // 2, 2, W // 2, 2).sum(axis=(1, 3), dtype=np.float32)


def utc_on_night(night, hhmmss):
    nd = datetime.strptime(night, "%Y-%m-%d").date()
    t = datetime.strptime(hhmmss, "%H:%M:%S" if hhmmss.count(":") == 2 else "%H:%M").time()
    day = nd if t.hour >= 12 else nd + timedelta(days=1)
    return datetime.combine(day, t, tzinfo=timezone.utc)


def sun_alt(dt):
    import warnings
    from astropy.coordinates import AltAz, EarthLocation, get_sun
    from astropy.time import Time
    import astropy.units as u
    warnings.filterwarnings("ignore")
    T = Time(dt)
    return get_sun(T).transform_to(AltAz(obstime=T, location=EarthLocation(lat=LAT * u.deg, lon=LON * u.deg))).alt.deg


def star_enu(radec, dt):
    import warnings
    from astropy.coordinates import AltAz, EarthLocation, SkyCoord
    from astropy.time import Time
    import astropy.units as u
    warnings.filterwarnings("ignore")
    radec = np.asarray(radec)
    aa = SkyCoord(radec[:, 0] * u.deg, radec[:, 1] * u.deg).transform_to(
        AltAz(obstime=Time(dt), location=EarthLocation(lat=LAT * u.deg, lon=LON * u.deg), pressure=0))
    return _enu(np.radians(aa.az.deg), np.radians(aa.alt.deg))


def cmd_refine(a):
    from scipy.optimize import least_squares
    cm = CameraModel(a.camera)
    gm = GlowModel(a.glow)
    t = utc_on_night(a.night, a.frame_utc)
    dt, path = min(night_frames(a.night), key=lambda tp: abs((tp[0] - t).total_seconds()))
    img = gm.subtract(load_binned(path))
    V = star_enu(cm.p["stars_radec_j2000"], mid(dt))
    px, py = cm.project(V)
    H, W = img.shape
    noise = 1.4826 * np.median(np.abs(img - np.median(img)))
    # 1. coarse global shift: score = summed (max-filtered, clipped) image at the
    #    predicted positions, over a +/-search_shift grid. A wrong nearest-peak
    #    match is common in a dense field; a whole-pattern shift is not.
    from scipy.ndimage import maximum_filter
    sm = maximum_filter(np.clip(img / noise, 0, 50), size=3)
    inb = (px > 90) & (px < W - 90) & (py > 90) & (py < H - 90)
    xi0, yi0 = np.round(px[inb]).astype(int), np.round(py[inb]).astype(int)
    R = a.search_shift
    best = (-1, 0, 0)
    for dy in range(-R, R + 1, 2):
        for dx in range(-R, R + 1, 2):
            sc = sm[yi0 + dy, xi0 + dx].sum()
            if sc > best[0]:
                best = (sc, dx, dy)
    base = sm[yi0, xi0].sum()
    print(f"  coarse shift ({best[1]:+d},{best[2]:+d}) px: pattern score {best[0]:.0f} vs {base:.0f} unshifted")
    px, py = px + best[1], py + best[2]
    meas, keep = [], []
    r = a.search
    for i, (x, y) in enumerate(zip(px, py)):
        xi, yi = int(round(x)), int(round(y))
        if not (r <= xi < W - r and r <= yi < H - r):
            continue
        cut = img[yi - r:yi + r + 1, xi - r:xi + r + 1]
        j = np.unravel_index(np.argmax(cut), cut.shape)
        if cut[j] < 8 * noise:
            continue
        cy, cx = yi - r + j[0], xi - r + j[1]
        s = img[cy - 2:cy + 3, cx - 2:cx + 3].clip(0)
        if s.shape != (5, 5) or s.sum() <= 0:
            continue
        gy, gx = np.mgrid[-2:3, -2:3]
        meas.append((cx + (s * gx).sum() / s.sum(), cy + (s * gy).sum() / s.sum()))
        keep.append(i)
    meas, keep = np.array(meas), np.array(keep)
    print(f"{path}\n  {len(keep)} of {len(V)} catalogue stars found within {r} px")
    off = np.hypot(px[keep] - meas[:, 0], py[keep] - meas[:, 1])
    print(f"  before refine: median offset {np.median(off):.2f} px")
    p0 = dict(cm.p)

    def resid(q):
        p0.update(az0=q[0], alt0=q[1], roll=q[2])
        json.dump(p0, open(a.out + ".tmp", "w"))
        m = CameraModel(a.out + ".tmp")
        x, y = m.project(V[keep])
        return np.concatenate([x - meas[:, 0], y - meas[:, 1]])

    s = least_squares(resid, [cm.p["az0"], cm.p["alt0"], cm.p["roll"]], loss="soft_l1", f_scale=1.0)
    os.remove(a.out + ".tmp")
    d = np.hypot(*np.split(s.fun, 2))
    p0.update(az0=float(s.x[0]), alt0=float(s.x[1]), roll=float(s.x[2]),
              refined_on=f"{a.night} {dt.isoformat()}", refine_median_px=float(np.median(d)),
              refine_n=int(len(keep)))
    json.dump(p0, open(a.out, "w"), indent=1)
    print(f"  after refine:  median offset {np.median(d):.2f} px  (pointing moved "
          f"{np.degrees(np.arccos(np.clip(_enu(np.array(cm.p['az0']), np.array(cm.p['alt0'])) @ _enu(np.array(s.x[0]), np.array(s.x[1])), -1, 1))):.3f} deg, "
          f"roll {np.degrees(s.x[2] - cm.p['roll']):+.3f} deg)\n  -> {a.out}")


def _align_one(args):
    """Per-frame similarity (tx, ty, rotation, magnification about the optical
    centre) between the camera model's predicted catalogue stars and the stars
    actually in the frame. Absorbs focus breathing (the LENSPOS sawtooth),
    slow thermal drift of scale and pointing, and timing error in one fit."""
    path, cam_path, glow_path = args
    cm, gm = CameraModel(cam_path), GlowModel(glow_path)
    ms = int(os.path.basename(path).split(".")[0])
    dt = mid(datetime.fromtimestamp(ms / 1000, timezone.utc))
    img = gm.subtract(load_binned(path))
    H, W = img.shape
    px, py = cm.project(star_enu(cm.p["stars_radec_j2000"], dt))
    noise = 1.4826 * np.median(np.abs(img[::4, ::4] - np.median(img[::4, ::4])))
    gy, gx = np.mgrid[-3:4, -3:4]
    P, M = [], []
    for x, y in zip(px, py):
        xi, yi = int(round(x)), int(round(y))
        if not (10 < xi < W - 10 and 10 < yi < H - 10):
            continue
        c = img[yi - 3:yi + 4, xi - 3:xi + 4]
        j = np.unravel_index(np.argmax(c), c.shape)
        cy, cx = yi - 3 + j[0], xi - 3 + j[1]
        st = img[cy - 3:cy + 4, cx - 3:cx + 4].clip(0)
        if st.shape != (7, 7) or st.max() < 15 * noise:
            continue
        P.append((x, y)); M.append((cx + (st * gx).sum() / st.sum(), cy + (st * gy).sum() / st.sum()))
    P, M = np.array(P), np.array(M)
    if len(P) < 20:
        return [ms, np.nan, np.nan, np.nan, np.nan, len(P), np.nan, np.nan]
    X, Y, d = P[:, 0] - cm.cx, P[:, 1] - cm.cy, M - P
    raw = float(np.median(np.hypot(*d.T)))
    keep = np.ones(len(P), bool)
    for _ in range(2):                                   # one round of 3-sigma rejection
        A = np.zeros((2 * keep.sum(), 4))
        A[0::2, 0] = 1; A[1::2, 1] = 1
        A[0::2, 2] = -Y[keep]; A[1::2, 2] = X[keep]; A[0::2, 3] = X[keep]; A[1::2, 3] = Y[keep]
        sol = np.linalg.lstsq(A, d[keep].ravel(), rcond=None)[0]
        rr = np.hypot(*(d[keep].ravel() - A @ sol).reshape(-1, 2).T)
        cut = max(3 * 1.48 * np.median(rr), 0.5)
        idx = np.nonzero(keep)[0]
        keep[idx[rr >= cut]] = False
    return [ms, *map(float, sol), int(keep.sum()), raw, float(np.median(rr[rr < cut]))]


def cmd_align(a):
    from multiprocessing import Pool
    frames = night_frames(a.night)
    if not a.all:
        frames = clean_frames(a.night, frames, a.glow, a.max_ratio)
    with Pool(a.jobs) as p:
        out = np.array(p.map(_align_one, [(f[1], a.camera, a.glow) for f in frames], chunksize=4))
    out = out[np.argsort(out[:, 0])]
    ok = np.isfinite(out[:, 1])
    dst = a.out or f"{BASE}/astrocam-frames/{a.night}/derot-sky-align.npy"
    np.save(dst, out)
    print(f"{ok.sum()} of {len(out)} frames aligned (median {np.median(out[ok, 5]):.0f} stars); star offset "
          f"from the model {np.median(out[ok, 6]):.2f} px -> {np.median(out[ok, 7]):.2f} px after the per-frame fit")
    for i, n, k in ((1, "tx px", 1), (2, "ty px", 1), (3, "rotation arcmin", 180 / np.pi * 60), (4, "magnification ppm", 1e6)):
        v = out[ok, i] * k
        print(f"  {n:18s} p5 {np.percentile(v, 5):+8.2f}  p50 {np.percentile(v, 50):+8.2f}  p95 {np.percentile(v, 95):+8.2f}")
    print(f"-> {dst}")


def load_align(path):
    """{epoch_ms: (tx, ty, rot, mag)} from `derot-sky align`; empty if no path."""
    if not path:
        return {}
    a = np.load(path)
    return {int(r[0]): tuple(r[1:5]) for r in a if np.isfinite(r[1])}


def _apply_align(x, y, cm, al):
    """model-predicted frame position -> where the star actually is in that frame."""
    tx, ty, th, m = al
    X, Y = x - cm.cx, y - cm.cy
    return x + tx - th * Y + m * X, y + ty + th * X + m * Y


def clean_frames(night, frames, glow_path, max_ratio):
    """Astronomically dark frames whose glow fit is clean (no cloud)."""
    frames = [f for f in frames if sun_alt(f[0]) < -18]
    # clean-sky selection from the night's block cube (skyglow-model cube), the
    # same green-calibrated test as `skyglow-model check`: residual of the glow
    # fit vs the sky-limited block noise (0.276 ADU at G level 29.6, ~sqrt(level))
    z = np.load(f"{BASE}/astrocam-frames/{night}/skyglow-cube.npz")
    g = np.load(glow_path)
    gmodes, gsky = (g["modes"][1] if g["modes"].ndim == 4 else g["modes"]), g["sky"].ravel()
    M = gmodes.reshape(len(gmodes), -1)[:, gsky].T
    Xc = z["cube"][:, 1, 0].reshape(len(z["t"]), -1)[:, gsky] - 64.0
    amp = np.linalg.lstsq(M, Xc.T, rcond=None)[0].T
    ratio = np.sqrt(np.mean((Xc - amp @ M.T) ** 2, 1)) / (0.276 * np.sqrt(np.clip(Xc.mean(1), 1, None) / 29.6))
    clean = {int(t) for t, r in zip(z["t"], ratio) if r < max_ratio}
    n0 = len(frames)
    frames = [f for f in frames if int(os.path.basename(f[1]).split(".")[0]) in clean]
    print(f"{n0} astronomically dark frames, {len(frames)} clean (glow-fit ratio < {max_ratio})")
    return frames


def _stack_chunk(args):
    import cv2
    chunk, cam_path, glow_path, t_ref, shape, erode, align = args
    cm, gm = CameraModel(cam_path), GlowModel(glow_path)
    H, W = shape
    yy, xx = np.mgrid[0:H, 0:W].astype(np.float32)
    Vref = cm.unproject(xx, yy)
    S = np.zeros(shape, np.float64)
    Wt = np.zeros(shape, np.float64)
    used = []
    mask = None
    for dt, path in chunk:
        raw = load_binned(path)
        img, amp, rms, level = gm.subtract(raw, return_fit=True)
        if level <= 0:
            continue
        if mask is None:
            mask = gm.sky_mask(img.shape, erode).astype(np.float32)
        x, y = cm.project(cm.sky_motion(Vref, (mid(dt) - t_ref).total_seconds()))
        ms = int(os.path.basename(path).split(".")[0])
        if align:
            if ms not in align:
                continue
            x, y = _apply_align(x, y, cm, align[ms])
        mx, my = x.astype(np.float32), y.astype(np.float32)
        samp = cv2.remap(img, mx, my, cv2.INTER_LINEAR, borderMode=cv2.BORDER_CONSTANT, borderValue=0)
        msk = cv2.remap(mask, mx, my, cv2.INTER_LINEAR, borderMode=cv2.BORDER_CONSTANT, borderValue=0)
        msk = (msk > 0.999).astype(np.float32)
        w = 1.0 / level
        S += w * msk * samp
        Wt += w * msk
        used.append((dt.isoformat(), float(rms), float(level)))
    return S, Wt, used


def _drizzle_chunk(args):
    """Point-kernel drizzle: carry every input pixel CENTRE to the sky at t_ref
    and drop its value into the nearest pixel of an output grid `scale` x finer.
    No interpolation, so no smoothing: bilinear resampling convolves every star
    with a 2-px triangle, and that softening is part of what cost the 10-07
    stack ~0.4 mag. The night's rotation scatters the drops over all sub-pixel
    phases, which is what fills the finer grid."""
    chunk, cam_path, glow_path, t_ref, shape, erode, scale, align = args
    cm, gm = CameraModel(cam_path), GlowModel(glow_path)
    H, W = shape
    Ho, Wo = H * scale, W * scale
    yy, xx = np.mgrid[0:H, 0:W].astype(np.float32)
    Vin0 = cm.unproject(xx, yy).reshape(-1, 3).astype(np.float32)
    P = np.stack([cm.b, cm.ex, cm.ey], 1)
    S = np.zeros(Ho * Wo, np.float64)
    Wt = np.zeros(Ho * Wo, np.float64)
    used = []
    keep = None
    for dt, path in chunk:
        img, amp, rms, level = gm.subtract(load_binned(path), return_fit=True)
        if level <= 0:
            continue
        if keep is None:
            keep = gm.sky_mask(img.shape, erode).ravel()
        ms = int(os.path.basename(path).split(".")[0])
        if align:
            if ms not in align:
                continue
            # a pixel at measured position p sits where the model puts p - d(p)
            tx, ty, th, m = align[ms]
            X, Y = xx - cm.cx, yy - cm.cy
            Vin = cm.unproject(xx - (tx - th * Y + m * X), yy - (ty + th * X + m * Y)).reshape(-1, 3).astype(np.float32)
        else:
            Vin = Vin0
        # frame-time direction -> the same sky direction at t_ref: undo dt of sky motion
        R = _rot_matrix(cm.pole, +SIDEREAL_RAD_PER_S * (mid(dt) - t_ref).total_seconds())
        D = Vin[keep] @ (R.T @ P).astype(np.float32)
        th = np.arctan2(np.hypot(D[:, 1], D[:, 2]), D[:, 0])
        phi = np.arctan2(D[:, 2], D[:, 1])
        r = cm.f * (th + cm.k * th ** 3)
        x = cm.cx + cm.mirror * r * np.cos(phi)
        y = cm.cy - r * np.sin(phi)
        iu = np.floor((x + 0.5) * scale).astype(np.int64)      # pixel i spans [i-0.5, i+0.5)
        iv = np.floor((y + 0.5) * scale).astype(np.int64)
        ok = (iu >= 0) & (iu < Wo) & (iv >= 0) & (iv < Ho)
        idx = iv[ok] * Wo + iu[ok]
        w = 1.0 / level
        S += np.bincount(idx, weights=w * img.ravel()[keep][ok], minlength=Ho * Wo)
        Wt += np.bincount(idx, minlength=Ho * Wo) * w
        used.append((dt.isoformat(), float(rms), float(level)))
    return S.reshape(Ho, Wo), Wt.reshape(Ho, Wo), used


def cmd_stack(a):
    from multiprocessing import Pool
    from astropy.io import fits
    frames = night_frames(a.night)
    t_ref = utc_on_night(a.night, a.ref_utc)
    if a.start:
        t0, t1 = utc_on_night(a.night, a.start), utc_on_night(a.night, a.end)
        frames = [f for f in frames if t0 <= f[0] < t1]
    frames = clean_frames(a.night, frames, a.glow, a.max_ratio)
    print(f"ref {t_ref.isoformat()}")
    shape = load_binned(frames[0][1]).shape
    chunks = [frames[i::a.jobs] for i in range(a.jobs)]
    align = load_align(a.align)
    if a.align:
        print(f"per-frame alignment from {a.align}: {len(align)} frames")
    with Pool(a.jobs) as p:
        if a.drizzle:
            parts = p.map(_drizzle_chunk, [(c, a.camera, a.glow, t_ref, shape, a.erode, a.drizzle, align) for c in chunks])
        else:
            parts = p.map(_stack_chunk, [(c, a.camera, a.glow, t_ref, shape, a.erode, align) for c in chunks])
    S = sum(pt[0] for pt in parts)
    Wt = sum(pt[1] for pt in parts)
    used = sorted(u for pt in parts for u in pt[2])
    mean = np.where(Wt > 0, S / np.maximum(Wt, 1e-30), np.nan).astype(np.float32)
    nmax = Wt.max()
    print(f"{len(used)} frames stacked (glow-fit ratio <= {a.max_ratio})")
    out = Path(a.out); out.mkdir(parents=True, exist_ok=True)
    hdr = fits.Header()
    hdr["NIGHT"] = a.night; hdr["REFUTC"] = t_ref.isoformat(); hdr["NFRAMES"] = len(used)
    hdr["CAMMODEL"] = os.path.basename(a.camera); hdr["GLOWMODL"] = os.path.basename(a.glow)
    hdr["COMMENT"] = "weighted mean of glow-subtracted frames, re-projected to the sky at REFUTC"
    hdr["ALIGN"] = (os.path.basename(a.align) if a.align else "none", "per-frame similarity from derot-sky align")
    hdr["DRIZZLE"] = (a.drizzle or 0, "0 = bilinear resample; N = point drizzle onto an N x finer grid")
    fits.HDUList([fits.PrimaryHDU(mean, hdr),
                  fits.ImageHDU((Wt / nmax).astype(np.float32), name="WEIGHT")]).writeto(out / "derot-sky.fits", overwrite=True)
    json.dump(used, open(out / "derot-sky-frames.json", "w"))
    # preview: asinh stretch over well-covered sky, black just below zero
    from PIL import Image
    good = Wt > 0.3 * nmax
    v = mean[good]
    sig = 1.4826 * np.median(np.abs(v - np.median(v)))
    lo, hi = np.median(v) - 1.0 * sig, np.percentile(v, 99.8)
    s = np.clip((np.nan_to_num(mean, nan=lo) - lo) / (hi - lo), 0, 1)
    s = np.arcsinh(s * a.asinh) / np.arcsinh(a.asinh)
    s[Wt < 0.05 * nmax] = 0
    Image.fromarray((s * 255).astype(np.uint8)).save(out / "derot-sky.jpg", quality=92)
    print(f"-> {out}/derot-sky.fits, derot-sky.jpg  (noise sigma {sig:.3f} ADU in the well-covered region)")


# --- sweep: sliding-window video ------------------------------------------

def _rot_matrix(axis, ang):
    """Matrix form of skyglow._rotate: v' = R v (Rodrigues)."""
    c, s_ = np.cos(ang), np.sin(ang)
    K = np.array([[0, -axis[2], axis[1]], [axis[2], 0, -axis[0]], [-axis[1], axis[0], 0]])
    return c * np.eye(3) + s_ * K + (1 - c) * np.outer(axis, axis)


class _Sweeper:
    """Per-worker state: the output grid's sky directions, and a cache of
    glow-subtracted, foreground-NaN'd frames (adjacent windows share ~9/10)."""

    def __init__(self, cam_path, glow_path, shape, erode):
        self.cm, self.gm = CameraModel(cam_path), GlowModel(glow_path)
        H, W = shape
        yy, xx = np.mgrid[0:H, 0:W].astype(np.float32)
        self.Vref = self.cm.unproject(xx, yy).reshape(-1, 3).astype(np.float32)
        self.shape, self.erode = shape, erode
        self.mask = None
        self.cache = {}
        self.clip_max = False

    def frame(self, path):
        if path not in self.cache:
            img, amp, rms, level = self.gm.subtract(load_binned(path), return_fit=True)
            if self.mask is None:
                self.mask = self.gm.sky_mask(img.shape, self.erode)
            img[~self.mask] = np.nan        # NaN spreads through INTER_LINEAR: masked edges go too
            sig = 1.4826 * np.nanmedian(np.abs(img[::4, ::4] - np.nanmedian(img[::4, ::4])))
            self.cache[path] = (img, level, sig)
        return self.cache[path]

    def maps(self, dt_s):
        """remap grids sampling a frame dt_s after the window's reference time:
        sky_motion then project, folded into one 3x3 matrix product."""
        cm = self.cm
        R = _rot_matrix(cm.pole, -SIDEREAL_RAD_PER_S * dt_s)
        D = (self.Vref @ (R.T @ np.stack([cm.b, cm.ex, cm.ey], 1)).astype(np.float32))
        th = np.arctan2(np.hypot(D[:, 1], D[:, 2]), D[:, 0])   # not arccos: float32 loses the axis
        phi = np.arctan2(D[:, 2], D[:, 1])
        r = cm.f * (th + cm.k * th ** 3)
        H, W = self.shape
        return ((cm.cx + cm.mirror * r * np.cos(phi)).reshape(H, W).astype(np.float32),
                (cm.cy - r * np.sin(phi)).reshape(H, W).astype(np.float32))

    def window(self, frames, t_c, clip):
        """(max, deep, coverage fraction) for frames [(dt, path)] at reference t_c."""
        import cv2
        H, W = self.shape
        if not frames:
            nan = np.full(self.shape, np.nan, np.float32)
            return nan, nan, np.zeros(self.shape, np.float32)
        samp = np.empty((len(frames), H, W), np.float32)
        wts, sigs = [], []
        for i, (dt, path) in enumerate(frames):
            img, level, sig = self.frame(path)
            mx, my = self.maps((mid(dt) - t_c).total_seconds())
            samp[i] = cv2.remap(img, mx, my, cv2.INTER_LINEAR,
                                borderMode=cv2.BORDER_CONSTANT, borderValue=float("nan"))
            wts.append(1.0 / max(level, 1e-3)); sigs.append(sig)
        wts = np.array(wts, np.float32)[:, None, None]
        sigs = np.array(sigs, np.float32)[:, None, None]
        ok = np.isfinite(samp)
        import warnings
        with warnings.catch_warnings():
            warnings.simplefilter("ignore", RuntimeWarning)
            vmax = np.nanmax(samp, axis=0)
            if len(frames) >= 3:
                med = np.nanmedian(samp, axis=0)
                ok &= ~(samp - med > clip * sigs)   # high side only: aircraft, satellites
        if self.clip_max and len(frames) >= 3:      # the max of the clipped samples only
            with warnings.catch_warnings():
                warnings.simplefilter("ignore", RuntimeWarning)
                vmax = np.nanmax(np.where(ok, samp, np.nan), axis=0)
        wsum = (wts * ok).sum(0)
        deep = np.where(wsum > 0, (wts * np.where(ok, samp, 0)).sum(0) / np.maximum(wsum, 1e-30), np.nan)
        cov = np.isfinite(samp).sum(0) / float(len(frames))
        return vmax.astype(np.float32), deep.astype(np.float32), cov.astype(np.float32)

    def prune(self, keep_paths):
        for k in [k for k in self.cache if k not in keep_paths]:
            del self.cache[k]


def _stretch_stats(img, cov, min_cov):
    v = img[(cov >= min_cov) & np.isfinite(img)]
    if v.size < 1000:
        return None
    med = np.median(v)
    sig = 1.4826 * np.median(np.abs(v - med))
    return med - 1.0 * sig, np.percentile(v, 99.8)


def _to_u8(img, cov, lohi, asinh, min_cov):
    lo, hi = lohi
    s = np.clip((np.nan_to_num(img, nan=lo) - lo) / (hi - lo), 0, 1)
    s = np.arcsinh(s * asinh) / np.arcsinh(asinh)
    s[cov < min_cov] = 0                       # no coverage: off-frame or foreground
    u = (s * 255).astype(np.uint8)
    return u[:u.shape[0] // 2 * 2, :u.shape[1] // 2 * 2]   # yuv420p wants even dims


def _sweep_chunk(args):
    import cv2
    wins, cam_path, glow_path, shape, a, stretch, dirs = args
    sw = _Sweeper(cam_path, glow_path, shape, a.erode)
    sw.clip_max = a.clip_max
    stats = []
    for k, (wi, t_c, frames) in enumerate(wins):
        vmax, deep, cov = sw.window(frames, t_c, a.clip)
        if stretch is None:
            stats.append((_stretch_stats(vmax, cov, a.min_cov), _stretch_stats(deep, cov, a.min_cov)))
        else:
            if dirs[0]:
                cv2.imwrite(str(dirs[0] / f"f{wi:04d}.png"), _to_u8(vmax, cov, stretch[0], a.asinh, a.min_cov))
            if dirs[1]:
                cv2.imwrite(str(dirs[1] / f"f{wi:04d}.png"), _to_u8(deep, cov, stretch[1], a.asinh, a.min_cov))
        nxt = {p for _, p in wins[k + 1][2]} if k + 1 < len(wins) else set()
        sw.prune(nxt)
        if stretch is not None and k % 30 == 0:
            print(f"  window {wi} ({t_c:%H:%M} UTC, {len(frames)} frames)", flush=True)
    return stats


def cmd_sweep(a):
    import shutil
    import subprocess
    from multiprocessing import Pool
    t0, t1 = utc_on_night(a.night, a.sweep_start), utc_on_night(a.night, a.sweep_end)
    frames = [f for f in night_frames(a.night) if t0 - timedelta(minutes=a.window_min) <= f[0] < t1]
    frames = clean_frames(a.night, frames, a.glow, a.max_ratio)
    if not frames:
        sys.exit("no clean frames in the sweep span")
    win, step = timedelta(minutes=a.window_min), timedelta(minutes=a.step_min)
    wins, w0 = [], t0
    while w0 + win <= t1:
        fr = [f for f in frames if w0 <= mid(f[0]) < w0 + win]
        wins.append((len(wins), w0 + win / 2, fr))
        w0 += step
    if a.max_windows:
        wins = wins[:a.max_windows]
    print(f"{len(wins)} windows of {a.window_min} min, step {a.step_min} min, "
          f"{t0:%H:%M}-{t1:%H:%M} UTC; {sum(1 for w in wins if not w[2])} empty")
    shape = load_binned(frames[0][1]).shape
    # contiguous chunks so each worker's frame cache is reused window to window
    n = len(wins)
    chunks = [wins[i * n // a.jobs:(i + 1) * n // a.jobs] for i in range(a.jobs)]
    chunks = [c for c in chunks if c]

    # 1. fixed stretch from sample windows (median of each window's black/white)
    busy = [w for w in wins if len(w[2]) >= 0.6 * a.window_min]
    samp = [busy[int(i)] for i in np.linspace(0, len(busy) - 1, min(a.jobs * 2, len(busy)))] if busy else wins[:1]
    with Pool(a.jobs) as p:
        st = [s for part in p.map(_sweep_chunk, [([w], a.camera, a.glow, shape, a, None, None) for w in samp])
              for s in part]
    stretch = []
    for m in (0, 1):
        v = np.array([s[m] for s in st if s[m] is not None])
        stretch.append((float(np.median(v[:, 0])), float(np.median(v[:, 1]))))
    print(f"fixed stretch from {len(samp)} windows: max {stretch[0][0]:.2f}..{stretch[0][1]:.2f}, "
          f"deep {stretch[1][0]:.2f}..{stretch[1][1]:.2f} ADU")

    # 2. render
    outs = [Path(a.out_max) if a.out_max else None, Path(a.out_deep) if a.out_deep else None]
    dirs = []
    for o in outs:
        d = None
        if o:
            d = o.with_name(o.stem + "-frames")
            if d.exists():
                shutil.rmtree(d)
            d.mkdir(parents=True)
        dirs.append(d)
    with Pool(a.jobs) as p:
        p.map(_sweep_chunk, [(c, a.camera, a.glow, shape, a, stretch, dirs) for c in chunks])

    # 3. encode; preset/threads honour publish-night-cam's host-aware env
    for o, d in zip(outs, dirs):
        if not o:
            continue
        subprocess.run(["ffmpeg", "-y", "-loglevel", "error",
                        "-threads", os.environ.get("FFMPEG_THREADS", "0"), "-framerate", str(a.fps),
                        "-i", str(d / "f%04d.png"), "-c:v", "libx264", "-pix_fmt", "yuv420p",
                        "-crf", "20", "-preset", os.environ.get("FFMPEG_PRESET", "medium"), str(o)], check=True)
        if not a.keep_frames:
            shutil.rmtree(d)
        print(f"wrote {o} ({o.stat().st_size / 1e6:.0f} MB)")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("refine"); r.add_argument("camera"); r.add_argument("night"); r.add_argument("frame_utc")
    r.add_argument("--glow", required=True); r.add_argument("--search", type=int, default=3)
    r.add_argument("--search-shift", type=int, default=80)
    r.add_argument("-o", "--out", required=True)
    al = sub.add_parser("align", help="measure each frame's offset from the camera model against catalogue stars")
    al.add_argument("camera"); al.add_argument("night"); al.add_argument("--glow", required=True)
    al.add_argument("--max-ratio", type=float, default=1.5); al.add_argument("--all", action="store_true",
                    help="align every frame, not only the clean ones")
    al.add_argument("-j", "--jobs", type=int, default=4); al.add_argument("-o", "--out")
    s = sub.add_parser("stack"); s.add_argument("camera"); s.add_argument("night")
    s.add_argument("--glow", required=True); s.add_argument("--ref-utc", required=True)
    s.add_argument("--from", dest="start"); s.add_argument("--to", dest="end")
    s.add_argument("--max-ratio", type=float, default=1.5)
    s.add_argument("--erode", type=int, default=2)
    s.add_argument("--asinh", type=float, default=8.0)
    s.add_argument("--align", help="per-frame alignment table from `derot-sky align` (corrects breathing and drift)")
    s.add_argument("--drizzle", type=int, default=0, metavar="N",
                   help="point-kernel drizzle onto an N x finer grid instead of bilinear resampling")
    s.add_argument("-j", "--jobs", type=int, default=4)
    s.add_argument("-o", "--out", required=True)
    w = sub.add_parser("sweep"); w.add_argument("camera"); w.add_argument("night")
    w.add_argument("--glow", required=True)
    w.add_argument("--sweep-start", default="22:00", help="UTC")
    w.add_argument("--sweep-end", default="04:00", help="UTC")
    w.add_argument("--window-min", type=float, default=10); w.add_argument("--step-min", type=float, default=1)
    w.add_argument("--fps", type=int, default=60)
    w.add_argument("--max-ratio", type=float, default=1.5)
    w.add_argument("--no-clip-max", dest="clip_max", action="store_false",
                   help="max over ALL samples; by default the max is taken over the clipped samples, because a plain max\n"
                        "draws everything fixed to the camera (hot pixels, dust, lit tree edges) and every aircraft as arcs")
    w.add_argument("--erode", type=int, default=3, help="3, not stack's 2: lit tree edges flicker in a video")
    w.add_argument("--clip", type=float, default=5.0, help="deep: drop samples this many frame-sigma above the median")
    w.add_argument("--min-cov", type=float, default=0.5, help="black where fewer than this fraction of the window's frames see the pixel")
    w.add_argument("--asinh", type=float, default=8.0)
    w.add_argument("--max-windows", type=int)
    w.add_argument("--keep-frames", action="store_true")
    w.add_argument("-j", "--jobs", type=int, default=4)
    w.add_argument("--out-max"); w.add_argument("--out-deep")
    a = ap.parse_args()
    {"refine": cmd_refine, "align": cmd_align, "stack": cmd_stack, "sweep": cmd_sweep}[a.cmd](a)


if __name__ == "__main__":
    main()

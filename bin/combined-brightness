#!/usr/bin/env python3
"""combined-brightness — overlay per-night brightness curves on a
shared 21:00 → 05:00 local axis.

Reads every per-night brightness CSV for a camera under the camera's
frames_root, computes stops above the per-night pedestal, and plots
one line per night onto a single PNG.

The key names each night by date only, and the baselines D4 and Dx. The
figures sit under the chart: each night's dark-trough index, the stops above
pedestal of its darkest 10-minute window, via the same darkest_anchor that
nightly-cam uses for the clear/cloudy verdict. Lower means a darker sky.
It replaced a single clear/cloudy threshold line (2026-08-24) — the line
drew the cut, the index reports the measurement the cut is made on, per
night and graded rather than binary.

Designed to be called once per `publish-night-cam` run so the combined
view is always current. Lands as a single fixed-key S3 object — no per-
night keys, no presigning lifetime concerns for the website.

Usage:
    combined-brightness --camera eclipticam-v3w \\
        [--out PATH] [--publish]
"""
import argparse
import csv
import math
import sys
from datetime import datetime, time, timedelta, timezone
from pathlib import Path
from zoneinfo import ZoneInfo

import numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import matplotlib.dates as mdates
from matplotlib.ticker import FuncFormatter

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from astro.config import CameraConfig
from astro.process.brightness import sky_mag_for
from astro.process.brightness import (brightness_baselines, chart_zero, darkest_anchor, notes_below,
                                      daylight_keep_mask, draw_baselines, excluded_spells,
                                      find_night_csvs, in_spells, lsb_align, night_exptime)

LONDON = ZoneInfo("Europe/London")


def load_curve(csv_path: Path, pedestal=None):
    """Returns (times_local, vals) where vals are floats from `mean`.
    Times are Europe/London datetimes. `pedestal` is passed through to
    lsb_align, which uses it to disarm the MSB test on sensors whose
    black level is itself above the cut (canon)."""
    rows = []
    spells = excluded_spells(csv_path.parent)
    with open(csv_path, newline="") as f:
        for row in csv.DictReader(f):
            try:
                t = datetime.fromisoformat(row["iso_utc"])
                if t.tzinfo is None:
                    t = t.replace(tzinfo=timezone.utc)
                v = float(row["mean"])
                if in_spells(t, spells):
                    continue
                rows.append((t.astimezone(LONDON), v))
            except (KeyError, ValueError):
                continue
    rows.sort()
    if not rows:
        return None, None
    # A handful of nights are stored MSB-aligned (64x); normalise so every
    # curve shares one ADU scale and the fixed pedestal means the same
    # thing on all of them. Without this, 9 of eclipticam's 76 nights plot
    # ~7.5 stops above the rest — two disjoint bands that read as a sky
    # change but are a bit-alignment change. See brightness.lsb_align.
    vals, _was_msb = lsb_align(np.array([r[1] for r in rows]), pedestal)
    return np.array([r[0] for r in rows]), vals


def to_anchor_axis(times, night_str: str):
    """Map real datetimes to a shared 21:00 → 05:00 axis anchored at
    a single reference date. A time of 23:00 on night N becomes the
    anchor date 23:00; 02:00 on night N+1 becomes anchor+1 day 02:00."""
    anchor_date = datetime(2000, 1, 1).date()
    anchor = datetime.combine(anchor_date, time(22, 0), tzinfo=LONDON)
    next_noon = datetime.combine(anchor_date + timedelta(days=1),
                                 time(12, 0), tzinfo=LONDON)
    out = np.empty(len(times), dtype=object)
    for i, t in enumerate(times):
        if t.hour >= 12:
            out[i] = anchor.replace(hour=t.hour, minute=t.minute,
                                    second=t.second)
        else:
            out[i] = next_noon.replace(hour=t.hour, minute=t.minute,
                                       second=t.second)
    return out


def dark_trough_stops(times_local, signal, window_s: float = 600.0):
    """Stops above pedestal of the night's darkest `window_s` window.

    The same dark-trough anchor `nightly-cam` uses for the clear/cloudy
    verdict (astro.process.brightness.darkest_anchor, so the window
    definition cannot drift apart from it) — reported here as a per-night
    number instead of a threshold line. Lower means a darker sky.

    Fed pedestal-subtracted mean ADU rather than the per_s that nightly-cam
    passes. At the fixed exposure and gain a night is captured with, the two
    are proportional, so the darkest window is the same one; and stops is
    log2(mean - pedestal) either way, matching nightly-cam's anchor_stops.
    """
    best = darkest_anchor(list(zip(times_local, signal)), window_s=window_s)
    if best is None:
        return None
    return math.log2(max(best[0], 0.5))


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n", 1)[0])
    ap.add_argument("--camera", required=True)
    ap.add_argument("--out", type=Path, default=None,
                    help="output PNG path (default: <frames-root>/"
                         "brightness-combined.png)")
    ap.add_argument("--publish", action="store_true",
                    help="upload to S3 as <camera>/brightness-combined.png "
                         "(no per-night prefix; one key)")
    ap.add_argument("--recent", "--limit", type=int, default=6,
                    dest="recent",
                    help="plot the N most recent nights (default 6) — "
                         "plus the camera.json reference_nights baseline, "
                         "for a total of 7 curves")
    ap.add_argument("--nights", default=None,
                    help="comma-separated YYYY-MM-DD nights to ALWAYS "
                         "include (e.g. a known dark reference night), "
                         "added to the --recent set and de-duplicated. "
                         "Defaults to camera.json 'reference_nights'.")
    args = ap.parse_args()

    cfg = CameraConfig.load(args.camera)

    # Standing reference nights from config, unless overridden on the CLI.
    # Lets the nightly published chart always show a known dark baseline
    # without hardcoding a date in the service scripts.
    if args.nights is None:
        ref_cfg = cfg.get("reference_nights")
        if ref_cfg:
            args.nights = ",".join(ref_cfg)
    # A subcam-output camera shares frames_root with its sibling (eclipticam-hq16
    # beside v3w), so its chart gets its own name there; v3w keeps the old one.
    # Only the local copy: the S3 key is per camera already. (#1066)
    default_name = "brightness-combined.png"
    if cfg.get("night_output") == "subcam":
        subcam = cfg.name.split("-", 1)[1] if "-" in cfg.name else cfg.name
        default_name = f"brightness-combined-{subcam}.png"
    out_path = args.out or (cfg.frames_root / default_name)

    all_nights = sorted(find_night_csvs(cfg), key=lambda nc: nc[0])
    if not all_nights:
        print(f"no per-night brightness CSVs under {cfg.frames_root}",
              file=sys.stderr)
        return 1
    by_str = {n: p for n, p in all_nights}

    # Selection: the N most recent, plus any explicit --nights (e.g. a
    # known dark night to compare against), de-duplicated and re-sorted.
    selected = {n for n, _ in all_nights[-args.recent:]}
    if args.nights:
        for want in (s.strip() for s in args.nights.split(",") if s.strip()):
            if want in by_str:
                selected.add(want)
            else:
                print(f"  --nights: {want} has no brightness CSV, skipping",
                      file=sys.stderr)
    nights = [(n, by_str[n]) for n in sorted(selected)]

    fig, ax = plt.subplots(figsize=(11, 5))
    cmap = plt.get_cmap("tab10")
    # Fixed zero point from camera.json (black_level, or pedestal where
    # that is on another basis; see chart_zero) — the same for every
    # night so curves are directly comparable. Falls back to per-night
    # p1 (loose, used only if camera.json lacks the calibration).
    fixed_pedestal, zero_label = chart_zero(cfg)
    # Drop DAYLIGHT frames: on cameras that run round the clock they land
    # in the same noon-to-noon CSV, read saturated, and draw as a flat line
    # across the top of the chart. The test is the sun's altitude, not the
    # clock — see brightness.daylight_keep_mask for why the old
    # 21:00-05:00 window cost this chart both walls of its bathtub.
    daylight_rule = None

    # Explicit reference nights (from --nights / config reference_nights).
    ref_set = set()
    if args.nights:
        ref_set = {s.strip() for s in args.nights.split(",") if s.strip()}
    # The latest night gets the prominent bold dashed-black line — it's the
    # one you care about most. Reference nights stay dashed (so they read as
    # "not a recent night") but coloured, not black.
    latest_night = nights[-1][0] if nights else None
    # Reference nights are drawn on the LATEST night's clock, not their
    # own: the 2026-07-25 baseline is BST, and on a GMT night its dark
    # trough would sit an hour late against the sky. Shifting it by the
    # offset difference lines its solar midnight up with tonight's. The
    # other nights keep their own wall clock, where the step at a clocks
    # change is plain to see and ages out by itself (Peter, 2026-10-25).
    latest_tz = None
    if latest_night:
        end = datetime.strptime(latest_night, "%Y-%m-%d").replace(
            hour=12, tzinfo=timezone.utc) + timedelta(days=1)
        latest_tz = end.astimezone(LONDON)

    # Exposure: the curves are mean ADU per FRAME, so a night shot with a
    # different exposure plots stops away from the rest for no sky reason
    # (astrocam 2026-10-09: 15 s subs, 1/4 the counts, -2 stops). Scale every
    # night to the camera's reference exposure (or the most common one
    # plotted); nights already at it are untouched.
    exps = {n: night_exptime(c) for n, c in nights}
    known = [round(e, 1) for e in exps.values() if e]
    # camera.json's sky_clear_ref_exptime is the basis nightly-cam's verdict
    # uses, so the chart and the verdict agree; else the commonest exposure
    ref_exp = cfg.get("sky_clear_ref_exptime") or (max(set(known), key=known.count) if known else None)

    plotted = 0
    trough_notes = []    # per night, for the text under the chart
    baseline_notes = []
    x_seen = []          # anchor-axis extent actually drawn, for set_xlim
    for i, (night_str, csv_p) in enumerate(nights):
        times, vals = load_curve(csv_p, fixed_pedestal)
        if times is None:
            continue
        keep, daylight_rule = daylight_keep_mask(times, cfg)
        times = times[keep]
        vals = vals[keep]
        if len(times) == 0:
            continue
        if fixed_pedestal is not None:
            pedestal = float(fixed_pedestal)
        else:
            pedestal = float(np.percentile(vals, 1))
        # Use small positive floor for the log: signal at or below
        # pedestal becomes ~0 stops, not a -10 clip artefact.
        e = exps.get(night_str)
        scale = ref_exp / e if (ref_exp and e and abs(e - ref_exp) > 0.5) else 1.0
        signal = np.maximum((vals - pedestal) * scale, 0.5)
        # Per-night dark-trough index, shown in the legend. Replaces the
        # clear/cloudy threshold line that used to be drawn here: the line
        # was the cut, this is the measurement it was cutting on, graded
        # rather than binary and readable straight off the y-axis.
        trough = dark_trough_stops(times, signal)
        idx = f"{trough:.2f}" if trough is not None else "-"
        if scale != 1.0:
            idx += f" ({e:.3g} s subs, \u00d7{scale:.1f})"
        is_latest = night_str == latest_night
        is_ref = night_str in ref_set
        ref_note = ""
        if is_ref and not is_latest and latest_tz is not None:
            shift = latest_tz.utcoffset() - times[len(times) // 2].utcoffset()
            if shift:
                times = np.array([t + shift for t in times], dtype=object)
                ref_note = f", on {latest_tz.tzname()}"
        xs = to_anchor_axis(times, night_str)
        # The key is the date alone; the figures go under the chart (Peter, 2026-11-02).
        if is_latest:
            style = dict(linewidth=2.0, linestyle="--", color="black",
                         zorder=6, label=night_str)
            trough_notes.append(f"{night_str} {idx} (latest, black dashed)")
        elif is_ref:
            style = dict(linewidth=1.4, linestyle="--", color=cmap(i % 10),
                         zorder=5, label=night_str)
            trough_notes.append(f"{night_str} {idx} (reference{ref_note}, dashed)")
        else:
            style = dict(linewidth=1.0, linestyle="-", color=cmap(i % 10),
                         zorder=2, label=night_str)
            trough_notes.append(f"{night_str} {idx}")
        # Plot as a thin line (1-min cadence is dense enough that points
        # would overlap into a smear). gapcolor=None keeps any frame-
        # less stretches visibly broken rather than interpolated.
        ax.plot(xs, signal, solid_joinstyle="round", **style)
        x_seen.append((min(xs), max(xs)))
        plotted += 1
        tag = "  [latest]" if is_latest else ("  [ref]" if is_ref else "")
        t_str = f"{trough:.2f}" if trough is not None else "-"
        print(f"  {night_str}: {len(times)} pts  pedestal={pedestal:.0f}  "
              f"dark-trough={t_str} bits{tag}")

    if not plotted:
        print("no curves plotted", file=sys.stderr)
        return 1

    # Baselines: darkest ever and 4-week lowest, as of the latest night, on
    # the same exposure basis as the curves. Drawn on the wall clock like them.
    lo_x = min(a for a, _ in x_seen)
    hi_x = max(b for _, b in x_seen)
    if ref_exp:
        def bin_x(k):
            day = datetime(2000, 1, 1, 12, tzinfo=LONDON) + timedelta(days=1 if k < 720 else 0)
            return to_anchor_axis([day.replace(hour=k // 60, minute=k % 60)], latest_night)[0]
        for h in draw_baselines(ax, brightness_baselines(cfg, fixed_pedestal, latest_night),
                                bin_x, float(ref_exp), lo_x, hi_x):
            ax.plot([], [], color=h.get_color(), linewidth=h.get_linewidth(), label=h.get_label())
            baseline_notes.append(h.note)

    ax.set_yscale("log", base=2)
    ax.yaxis.set_major_formatter(FuncFormatter(
        lambda y, _pos: f"{math.log2(y):.0f}" if y > 0 else ""))
    # Just the zone: the axis is plainly a London clock. Taken from the latest
    # night, whose clock the chart is on (it said "BST" all winter until 2026-11-02).
    ax.set_xlabel(latest_tz.tzname() if latest_tz is not None else "London time")
    ax.set_ylabel("sky brightness, bits (stops)")
    # Right axis in sky surface brightness where camera.json calibrates it
    # (sky_mag: astro-science's Gaia G zero point). Stops are log2 of the
    # 60 s-equivalent sky flux, so mag is linear in them.
    sm = sky_mag_for(cfg, latest_night)
    if sm and zero_label == "black level":
        m0, s0, k = float(sm["mag"]), float(sm["at_stops"]), float(sm["mag_per_stop"])
        sec = ax.secondary_yaxis(
            "right",
            functions=(lambda y: m0 - k * (np.log2(np.clip(y, 1e-9, None)) - s0),
                       lambda m: np.power(2.0, s0 + (m0 - np.asarray(m)) / k)))
        from matplotlib.ticker import FormatStrFormatter, MultipleLocator, NullLocator
        sec.yaxis.set_major_locator(MultipleLocator(0.5))
        sec.yaxis.set_minor_locator(NullLocator())
        sec.yaxis.set_major_formatter(FormatStrFormatter("%.1f"))
        sec.set_ylabel(f"mag/arcsec\u00b2 ({sm.get('band', '')}, approx.)")
    # The title says what the reader is looking at, not what the pipeline
    # did. "v3w — 7 nights, 1 of them reference" named the camera the page
    # already names and a curve count the reader can see; it told a visitor
    # nothing about what the picture means (Peter, 2026-09-19). The per-night
    # detail still goes to stdout above, where the operator wants it.
    # Darkness is what the reader is after; the axis still measures it as a
    # brightness in bits (Peter, 2026-11-02).
    ax.set_title("How dark the sky was overnight")
    ax.grid(True, alpha=0.3)
    ax.xaxis.set_major_locator(mdates.HourLocator(interval=1))
    ax.xaxis.set_major_formatter(
        mdates.DateFormatter("%H:%M", tz=LONDON))
    anchor_date = datetime(2000, 1, 1).date()
    # Both edges derived from the curves actually drawn, snapped out to
    # the whole hour — same rule as the per-night chart. Until 2026-08-25
    # this was a hard 22:00 while _in_observing_window() admitted points
    # from 21:00, so an hour of admitted data was drawn off-canvas: the
    # earliest measurements of every night, which is exactly where capture
    # starting is visible. Deriving the frame from the data means the two
    # cannot drift apart again.
    #
    # The seasonal limit this note used to warn about — a daylight filter
    # written in clock hours, discarding real evening data before the axis
    # ever saw it — was fixed on 2026-09-21 by gating on sun altitude
    # instead (brightness.daylight_keep_mask). Both edges are now honest
    # all year.
    lo = min(a for a, _ in x_seen)
    hi = max(b for _, b in x_seen)
    lo = lo.replace(minute=0, second=0, microsecond=0)
    hi_floor = hi.replace(minute=0, second=0, microsecond=0)
    hi = hi_floor + timedelta(hours=1) if hi_floor < hi else hi
    ax.set_xlim(lo, hi)
    # Outside the axes, so it never sits on the dawn rise. Names only: dates, D4, Dx.
    ax.legend(loc="upper left", bbox_to_anchor=(1.12 if sm else 1.01, 1.0), fontsize=8,
              borderaxespad=0.0, handlelength=1.6)
    fig.autofmt_xdate()
    fig.tight_layout()
    # Darkest 10 minutes of each night, as many to a line as read comfortably.
    per_line = 4
    rows = [" \u00b7 ".join(trough_notes[j:j + per_line])
            for j in range(0, len(trough_notes), per_line)]
    notes_below(fig, ["Darkest 10 minutes of each night, sky brightness in bits (lower is darker):"]
                + ["   " + r for r in rows] + baseline_notes)
    out_path.parent.mkdir(parents=True, exist_ok=True)
    fig.savefig(out_path, dpi=110, facecolor="white", bbox_inches="tight")
    plt.close(fig)
    print(f"daylight filter: {daylight_rule}")
    print(f"wrote {out_path}")

    if args.publish:
        from astro.present import privacy as P
        # Plot has no camera pixels — privacy-safe by construction
        if getattr(cfg, "privacy", None):
            P.mark_ok(out_path)
        import boto3
        bucket = cfg.s3["bucket"]
        # cfg.s3.prefix is "<camera>/nights"; strip the "/nights" suffix
        # so the combined plot sits at "<camera>/brightness-combined.png"
        # — one stable key, no per-night nesting.
        cam_prefix = cfg.s3["prefix"].removesuffix("/nights")
        key = f"{cam_prefix}/brightness-combined.png"
        s3 = boto3.client("s3")
        s3.upload_file(str(out_path), bucket, key,
                       ExtraArgs={"ContentType": "image/png"})
        print(f"uploaded s3://{bucket}/{key}")
    return 0


if __name__ == "__main__":
    sys.exit(main())

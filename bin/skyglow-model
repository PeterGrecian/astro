#!/usr/bin/env python3
"""skyglow-model — model a night's sky glow as a few fixed spatial modes.

The glow is fixed in the camera frame while the stars move, so a star-rejected
background (block medians) stacked over a clear night factorises: on
astrocam 2026-10-07 ONE spatial map times ONE time curve held 99.98% of the
green variance, and two modes reached the block-median noise floor (~0.25 ADU).
The model per frame is then B(x,y,t) = a1(t) M1(x,y) + a2(t) M2(x,y): two
numbers per frame per colour, against the thousands a mesh background spends
(and which eat extended signal: the Milky Way survives this subtraction).

Two steps, because the first reads every frame and must run where they live:

    bigstore-run --get cube_astrocam_2026-10-07.npz bin/skyglow-model cube astrocam 2026-10-07
    bigstore-run bin/skyglow-model cube astrocam 2026-10-07 --to-night   # file it beside the frames
    skyglow-model fit cube_astrocam_2026-10-07.npz [--from 20.5 --to 5.5]

`cube`  -> cube_<cam>_<night>.npz: t (epoch ms), cube [n, RGB, (median,p20), Y, X]
           in 24-superpixel blocks, temp (SENSTEMP).
`fit`   -> model_<cam>_<night>.npz: modes [RGB, 2, Y, X] in ADU above black for
           unit amplitude, amp [n, RGB, 2], sky mask; prints the rank, the
           residual per mode count, and the glow curve with colour ratios.

To subtract: fit the two amplitudes of a frame against the modes on the sky
blocks (least squares on its own block medians), upsample the modes with a
cubic spline over block centres, subtract. Window: Europe/London hours; frames
outside it (twilight) are excluded from the modes but still get amplitudes.

Caveat: modes built from one night absorb the night-averaged Milky Way, which
rotates through the field. Modes from several nights, or an iterative mask,
would not.
"""
from __future__ import annotations

import argparse
import glob
import os
import sys
from datetime import datetime, timezone
from zoneinfo import ZoneInfo

import numpy as np

BS = 24          # block size in superpixels
BLACK = 64.0     # BLACKLVL on imx708 / these cameras
LONDON = ZoneInfo("Europe/London")


def frame_root(cam: str, night: str) -> str:
    base = os.environ.get("BIGSTORE", "/mnt/muppet/bigstore")
    return {"astrocam": f"{base}/astrocam-frames/{night}",
            "eclipticam-v3w": f"{base}/eclipticam-frames/night/{night}/v3w",
            "ecl": f"{base}/eclipticam-frames/night/{night}/v3w"}[cam]


def _block_stats(f: str):
    from astropy.io import fits
    with fits.open(f) as h:
        d = h[1].data.astype(np.float32)
        temp = h[1].header.get("SENSTEMP", np.nan)
    planes = (d[0::2, 0::2], 0.5 * (d[0::2, 1::2] + d[1::2, 0::2]), d[1::2, 1::2])
    out = []
    for p in planes:
        hh, ww = p.shape[0] // BS, p.shape[1] // BS
        q = p[:hh * BS, :ww * BS].reshape(hh, BS, ww, BS).transpose(0, 2, 1, 3).reshape(hh, ww, -1)
        out.append(np.stack([np.median(q, axis=2), np.percentile(q, 20, axis=2)]))
    return int(os.path.basename(f).split(".")[0]), np.stack(out), temp


def cmd_cube(a):
    from multiprocessing import Pool
    files = sorted(glob.glob(frame_root(a.camera, a.night) + "/[0-2][0-9]/*.fits.fz"))
    if not files:
        sys.exit(f"skyglow-model: no frames for {a.camera} {a.night}")
    with Pool(a.jobs) as p:
        res = sorted(p.map(_block_stats, files, chunksize=8), key=lambda r: r[0])
    out = (os.path.join(frame_root(a.camera, a.night), "skyglow-cube.npz") if a.to_night
           else a.out or f"cube_{a.camera}_{a.night}.npz")
    np.savez_compressed(out, t=np.array([r[0] for r in res]),
                        cube=np.stack([r[1] for r in res]).astype(np.float32),
                        temp=np.array([r[2] for r in res], float))
    print(f"{out}: {len(res)} frames")


def local_hours(t_ms):
    return np.array([(lambda d: d.hour + d.minute / 60)(
        datetime.fromtimestamp(x / 1000, timezone.utc).astimezone(LONDON)) for x in t_ms])


def cmd_fit(a):
    z = np.load(a.cube)
    t, cube = z["t"], z["cube"]
    hh = local_hours(t)
    use = (hh >= a.start) | (hh < a.end) if a.start > a.end else (hh >= a.start) & (hh < a.end)
    X = cube[:, :, 0] - BLACK                     # medians, above black
    n, _, ny, nx = X.shape
    # sky blocks: follow the global sky curve (foreground does not) and sit above black
    g = X[use, 1].reshape(use.sum(), -1)
    ref = np.median(g, 1)
    corr = np.array([np.corrcoef(g[:, j], ref)[0, 1] for j in range(g.shape[1])])
    # "above black" relative to the sky, not 5 ADU flat: at 15 s the darker
    # corners sit under 5 ADU and were dropped (5 ADU was 0.18 of 60 s sky)
    sky = (corr > a.min_corr) & (np.median(g, 0) > 0.18 * np.median(g))
    print(f"{use.sum()} of {n} frames in window, {sky.sum()} of {sky.size} blocks sky")
    # Sky blocks are found on the whole window above (they need the dusk and
    # cloud swings to show they track the sky); the modes on clear sky only.
    # Clear dark sky only. An unweighted SVD is ruled by its brightest frames,
    # so a cloud spell inside the window (2026-10-09, 20:28-21:15, up to 15x
    # the clear level) made the "glow" modes cloud-shaped and every clear frame
    # was then subtracted wrongly. Keep astronomically dark frames whose sky
    # sits within --max-stops of the night's dark floor (10th percentile).
    lev = np.median(X[:, 1].reshape(len(t), -1), 1)
    dark = sun_moon_alt(t)[0] < -18
    if dark.sum() >= 10:
        floor = np.percentile(lev[use & dark], 10) if (use & dark).any() else np.inf
        keep = use & dark & (lev <= floor * 2 ** a.max_stops)
        mins = keep.sum() * np.median(np.diff(np.sort(t))) / 60000
        print(f"{(use & dark).sum()} dark frames in window, {keep.sum()} within "
              f"{a.max_stops:g} stop of the floor ({floor:.1f} ADU) = {mins:.0f} min")
        if mins < a.min_minutes:
            sys.exit(f"too little clear dark sky to fit a glow model "
                     f"({mins:.0f} min < {a.min_minutes:g}); use a reference model")
        use = keep
    modes = np.zeros((3, 2, ny, nx), np.float32)
    amp = np.zeros((n, 3, 2), np.float32)
    for k, name in enumerate("RGB"):
        A = X[use, k].reshape(use.sum(), -1)
        U, s, Vt = np.linalg.svd(A[:, sky], full_matrices=False)
        ev = s ** 2 / np.sum(s ** 2)
        rr = [np.sqrt(np.mean((A[:, sky] - (U[:, :q] * s[:q]) @ Vt[:q]) ** 2)) for q in (1, 2, 3)]
        # sign so mode 1 is positive; scale so mode 1 has unit mean on sky
        sgn = np.sign(Vt[0].mean())
        T = U[:, :2] * s[:2] * sgn
        coef, *_ = np.linalg.lstsq(T, A, rcond=None)   # extend to every block
        m1 = coef[0].reshape(ny, nx); scale = m1.ravel()[sky].mean()
        modes[k, 0] = m1 / scale
        modes[k, 1] = coef[1].reshape(ny, nx) / scale
        M = np.stack([modes[k, 0].ravel()[sky], modes[k, 1].ravel()[sky]], 1)
        amp[:, k] = np.linalg.lstsq(M, X[:, k].reshape(n, -1)[:, sky].T, rcond=None)[0].T
        print(f"  {name}: level {A[:, sky].mean():5.1f} ADU  mode-1 share {ev[0]:.5f}  "
              f"resid rms with 1/2/3 modes {rr[0]:.3f} {rr[1]:.3f} {rr[2]:.3f} ADU")
    out = a.out or os.path.basename(a.cube).replace("cube_", "model_")
    np.savez_compressed(out, modes=modes, amp=amp, t=t, sky=sky.reshape(ny, nx), bs=BS, black=BLACK)
    a1 = amp[:, :, 0]
    floor = np.median(a1[use, 1][np.argsort(a1[use, 1])[:max(5, use.sum() // 10)]])
    print(f"\n{out}\n  local   glow G   x floor   R/G    B/G")
    step = max(1, n // 24)
    for i in range(0, n, step):
        print(f"  {hh[i]:5.2f}  {a1[i, 1]:7.2f}   {a1[i, 1] / floor:5.2f}   "
              f"{a1[i, 0] / a1[i, 1]:.3f}  {a1[i, 2] / a1[i, 1]:.3f}{'' if use[i] else '   (outside window)'}")


def sun_moon_alt(t_ms):
    """Sun and moon altitude (deg) at the house, per frame."""
    import warnings
    from astropy.coordinates import AltAz, EarthLocation, get_body, get_sun
    from astropy.time import Time
    import astropy.units as u
    warnings.filterwarnings("ignore")
    loc = EarthLocation(lat=51.3948 * u.deg, lon=-0.2923 * u.deg)
    T = Time(np.asarray(t_ms) / 1000, format="unix")
    fr = AltAz(obstime=T, location=loc)
    return get_sun(T).transform_to(fr).alt.deg, get_body("moon", T, loc).transform_to(fr).alt.deg


def cmd_check(a):
    """Fit every frame of each cube with a model's modes; a frame whose residual
    sits at the noise floor for its sky level is 'clean': clear, unlit by the moon,
    and seeing the same glow pattern as the model night."""
    m = np.load(a.model)
    modes, sky = m["modes"], m["sky"].ravel()
    # per-block noise at the model night: 2-mode residual 0.276 ADU at G level 29.6,
    # scaling as sqrt(level) (sky-limited, measured on 2026-10-07)
    s0, l0 = 0.276, 29.6
    M = np.stack([modes[1, 0].ravel()[sky], modes[1, 1].ravel()[sky]], 1)
    print("night        frames  dark  clean  clean-hours  median-ratio  (ratio = resid / expected noise)")
    rows = []
    for path in a.cubes:
        z = np.load(path)
        t, X = z["t"], z["cube"][:, 1, 0].reshape(len(z["t"]), -1)[:, sky] - BLACK
        amp = np.linalg.lstsq(M, X.T, rcond=None)[0].T
        resid = np.sqrt(np.mean((X - amp @ M.T) ** 2, axis=1))
        level = X.mean(1)
        ratio = resid / (s0 * np.sqrt(np.clip(level, 1, None) / l0))
        sun, moon = sun_moon_alt(t)
        dark = sun < -18
        clean = dark & (ratio < a.max_ratio)
        night = os.path.basename(os.path.dirname(path)) if os.path.basename(path) == "skyglow-cube.npz" \
            else os.path.basename(path)
        print(f"{night:12s} {len(t):6d} {dark.sum():5d} {clean.sum():6d}  {clean.sum() / 60:9.1f}"
              f"   {np.median(ratio[dark]) if dark.any() else np.nan:9.2f}")
        rows.append((night, t, amp, resid, ratio, level, sun, moon, clean))
    if a.out:
        np.savez_compressed(a.out, **{f"{r[0]}__{k}": v for r in rows
                                      for k, v in zip(("t", "amp", "resid", "ratio", "level", "sun", "moon", "clean"), r[1:])})
        print(f"\nper-frame table -> {a.out}")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    c = sub.add_parser("cube", help="frames -> block-median cube (run via bigstore-run)")
    c.add_argument("camera"); c.add_argument("night")
    c.add_argument("-j", "--jobs", type=int, default=4); c.add_argument("-o", "--out")
    c.add_argument("--to-night", action="store_true",
                   help="write skyglow-cube.npz beside the frames (archive product) instead of cwd")
    f = sub.add_parser("fit", help="cube -> two-mode glow model")
    f.add_argument("cube")
    f.add_argument("--from", dest="start", type=float, default=20.5, help="window start, London hours")
    f.add_argument("--to", dest="end", type=float, default=5.5, help="window end, London hours")
    f.add_argument("--min-corr", type=float, default=0.9)
    f.add_argument("--max-stops", type=float, default=0.6,
                   help="fit only frames within this many stops of the night's dark floor (default 0.6)")
    f.add_argument("--min-minutes", type=float, default=60,
                   help="refuse (exit 1) with less clear dark sky than this; the pipeline then "
                        "falls back to <camera>/skyglow-ref.npz (default 60)")
    f.add_argument("-o", "--out")
    k = sub.add_parser("check", help="fit each frame of other nights' cubes with a model; count clean frames")
    k.add_argument("model"); k.add_argument("cubes", nargs="+")
    k.add_argument("--max-ratio", type=float, default=1.5,
                   help="clean if residual < this x the expected block noise (default 1.5)")
    k.add_argument("-o", "--out", help="save the per-frame table (npz)")
    a = ap.parse_args()
    {"cube": cmd_cube, "fit": cmd_fit, "check": cmd_check}[a.cmd](a)


if __name__ == "__main__":
    main()

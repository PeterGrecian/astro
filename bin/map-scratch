#!/usr/bin/env python3
"""map-scratch — low-resolution scratch pass for THE MAP.

Thin CLI over astro.map.scratch. See that module and
design/accumulation-bucket-refinement.md ("Scratch runs") for the why.

  map-scratch --root /mnt/bigstore/astro-data/astrocam-frames \
              --out ~/tmp/map-scratch-astrocam.csv

MUST run on the host holding the frames (compute follows the data): the same
read is 0.09 s/frame on muppet's local disk and 1.65 s over pip's wifi mount —
~2.2 h vs ~40 h for astrocam's 88,415 frames. Wrap it:

  nice -19 ionice -c3 map-scratch ...

as astro-storage requires (muppet NFS-exports the tree to the whole subnet).
Run bin/inventory-drift FIRST — it exits 1 on a bad path in 30 s rather than
three hours in.
"""
import pathlib
import sys

REPO = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO))

from astro.map.scratch import main  # noqa: E402

if __name__ == "__main__":
    main()

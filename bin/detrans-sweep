#!/usr/bin/env python3
"""detrans-sweep — animate de-translated (detrans) stacks across a night.

For a far-off-pole camera (eclipticam-v3w) the star motion across the
sensor is, over a short window, a near-uniform TRANSLATION. "Detrans" a
window = undistort each frame (k1,k2), shift each by -v*(t-t0) to cancel
that translation, then max-stack — the per-frame 60 s streaks overlap
into one sharp, high-SNR streak per star instead of smearing across the
window. Sliding the window 1 min per output frame and encoding the
stacks to mp4 gives an animation of the night with registered streaks.

Calibration (eclipticam-v3w, from the star-trail distortion + detrans
velocity work, worklog 2026-06-21): k1=-0.636, k2=+0.311 (radial,
binned 1152x648, centre=frame centre, rho=half-diag); v=0.040 px/s at
7.8 deg from horizontal.

Step-by-step friendly: --max-windows N processes only the first N
output frames (a short slice) so you can check + time before the full
night.

Usage
-----
    detrans-sweep --camera eclipticam-v3w --night 2026-06-20 \\
        --window-min 10 --step-min 1 --out ~/tmp/detrans-sweep.mp4 \\
        [--max-windows 20]
"""
from __future__ import annotations

import argparse
import glob
import os
import subprocess
import sys
import time
from pathlib import Path

import numpy as np
import cv2
from astropy.io import fits

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from astro.config import CameraConfig

# eclipticam-v3w calibration — fallback defaults; the real values are
# read from camera.json (distortion + detrans blocks).
#
# Detrans velocity is stored resolution-INDEPENDENTLY as a fraction of
# image WIDTH per second, so it survives capture-resolution changes (the
# night daemon went 2304x1296 binned -> 4608x2592 full-res on 2026-06-22).
# At runtime it is scaled to whatever width the working frame is at:
#   v_px_per_s = v_frac_per_s * W.
# The original fit was v=0.040 px/s on the binned 1152-wide geometry, i.e.
# 0.040 / 1152 = 3.4722e-5 of the width per second.
K1, K2 = -0.636, 0.311
V_FRAC_PS = 0.040 / 1152.0        # fraction of image width per second
V_ANGLE_DEG = 7.8

# Crop fractions to trim the barrel-undistort black border, per edge
# (left, right, top, bottom). Established by hand in GIMP from a real
# detrans frame (peter@pip 2026-06-28). The two modes differ only on the
# RIGHT edge: deep uses the closer "version 2" framing (~1.84 aspect),
# trimming more of the busy ghost/streak region on the right; max keeps it
# wider (~2.31). yuv420p/libx264 needs even dims — the slice below rounds
# down to even.
_CLOSE_CROP = (0.142, 0.299, 0.189, 0.270)   # L, R, T, B -> ~1.84 aspect
CROP_FRAC = {
    #          left,   right,  top,    bottom
    "max":  (0.142, 0.155, 0.189, 0.270),   # 2.31 aspect (wider)
    "deep": _CLOSE_CROP,                     # 1.84 aspect (closer, deep only)
}


# Frames come in two on-disk naming schemes:
#   - newer eclipticam capture: <epoch_ms>.fits.fz (13-digit UTC ms)
#   - older nights (muppet):    HH/NNNN.fits.fz (per-hour sequential index),
#     with the real time only in the FITS DATE-OBS header.
# Windowing needs the true capture time, so resolve it from the filename when
# it's a plausible epoch_ms, else from DATE-OBS. Cache so we read each header
# at most once (the sort key + ts build would otherwise open it repeatedly).
_EPOCH_MS_MIN = 1_000_000_000_000   # ~2001-09; anything smaller is an index
_epoch_cache: dict = {}


def epoch_ms(p):
    key = str(p)
    if key in _epoch_cache:
        return _epoch_cache[key]
    stem = Path(p).name.split(".")[0]
    if stem.isdigit() and int(stem) >= _EPOCH_MS_MIN:
        ms = int(stem)
    else:
        # Fall back to the FITS header timestamp (DATE-OBS, ISO-8601 UTC).
        from datetime import datetime
        hdr = fits.open(p)[1].header
        iso = hdr.get("DATE-OBS") or hdr.get("DATE")
        if not iso:
            raise ValueError(f"{p}: no epoch_ms filename and no DATE-OBS header")
        ms = int(datetime.fromisoformat(iso).timestamp() * 1000)
    _epoch_cache[key] = ms
    return ms


def load_bin(p, n=1):
    """Load a v3w frame and optionally n×n sum-bin it.

    n=1 keeps full resolution (the default — we want the detail). n>1
    bins for speed/SNR. Resolution no longer needs to match any fixed
    calibration geometry: distortion rho is normalised (scale-invariant)
    and detrans v is a fraction of image width (scaled to W at runtime),
    so both survive the 2026-06-22 full-res switch and any binning."""
    d = fits.open(p)[1].data.astype(np.float32)
    if n <= 1:
        return d
    H, W = d.shape
    H, W = H // n * n, W // n * n
    d = d[:H, :W]
    return d.reshape(H // n, n, W // n, n).sum(axis=(1, 3))


def undistort_map(H, W, k1=K1, k2=K2):
    cx, cy = (W - 1) / 2.0, (H - 1) / 2.0
    R = 0.5 * np.hypot(W, H)
    ys, xs = np.mgrid[0:H, 0:W].astype(np.float32)
    dx, dy = xs - cx, ys - cy
    rt = np.sqrt(dx * dx + dy * dy) / R
    s = np.ones_like(rt)
    for _ in range(12):
        rd = rt / s
        s = 1 + k1 * rd * rd + k2 * rd ** 4
    return (cx + dx / s).astype(np.float32), (cy + dy / s).astype(np.float32)


def stretch_u8(img, lo_pct=50, hi_pct=99.6, linear=False):
    """asinh percentile stretch (max mode) or a plain LINEAR percentile
    clip (deep mode). The linear lo=13 hi=97.4 default matches splay's
    own stretch (fits_array_to_surface) tuned for the deep mean-bg
    image — black at the noise floor, white at p97.4, so the faint
    stars span the full range."""
    ok = np.isfinite(img)              # NaN = masked foreground -> black
    lo, hi = np.percentile(img[ok], lo_pct), np.percentile(img[ok], hi_pct)
    x = np.clip((np.where(ok, img, lo) - lo) / max(hi - lo, 1e-6), 0, 1 if linear else None)
    if linear:
        return (x * 255).astype(np.uint8)
    return np.clip(np.arcsinh(x * 12) / np.arcsinh(12) * 255, 0, 255).astype(np.uint8)


def stretch_signed_u8(img, hi_pct=99.8, asinh=8.0, sig_below=1.0):
    """For background-subtracted (signed, zero-centred) images: black
    sig_below noise-sigmas below the median, white at hi_pct, asinh between.
    A max of N frames sits above zero, so it takes a negative sig_below."""
    v = img[::4, ::4]
    v = v[np.isfinite(v)]              # NaN = masked foreground -> black
    med = float(np.median(v))
    sig = 1.4826 * float(np.median(np.abs(v - med)))
    lo, hi = med - sig_below * sig, float(np.percentile(v, hi_pct))
    x = np.clip((np.where(np.isfinite(img), img, lo) - lo) / max(hi - lo, 1e-6), 0, 1)
    return (np.arcsinh(x * asinh) / np.arcsinh(asinh) * 255).astype(np.uint8)


def local_bg_subtract(img, down=4, med=13):
    """Subtract a large-kernel median background (downsample-filter-
    upsample for speed). Used by deep mode to remove the sky pedestal
    so faint registered stars sit on a near-zero, low-noise floor —
    the maximum-SNR / deepest path."""
    from scipy import ndimage
    small = cv2.resize(img, (img.shape[1] // down, img.shape[0] // down),
                       interpolation=cv2.INTER_AREA)
    bg_small = ndimage.median_filter(small, size=med)
    bg = cv2.resize(bg_small, (img.shape[1], img.shape[0]),
                    interpolation=cv2.INTER_LINEAR)
    return np.clip(img - bg, 0, None)


def block_levels(f, g=8):
    """g x g grid of block medians (every 7th pixel): the frame's level map."""
    H, W = f.shape
    h, w = H // g, W // g
    b = f[:h * g, :w * g].reshape(g, h, g, w).transpose(0, 2, 1, 3).reshape(g, g, -1)
    return np.median(b[:, :, ::7], axis=2)


class RunningMedian:
    """Per-pixel temporal median background, in the CAMERA frame.

    eclipticam points far from the pole, so stars drift ~5 px/min against a
    2-3 px FWHM: across N=21 one-minute frames a pixel holds a star for about
    one frame, and the median is the static scene alone (glare, glass
    reflections, dust donuts, lit houses) at full resolution and any shape.
    Subtract it BEFORE undistort/registration, where that scene is fixed.

    Glare that SWITCHES (a house light, 2026-10-07 03:13-03:56 UTC: 500-900
    ADU across the whole frame) breaks a median that straddles the switch.
    So a level pass splits the night into segments wherever at least
    `step_blocks` of the 8x8 blocks jump by more than `step_adu` between
    consecutive frames (10 and 10 at bin 2: glare flicker while the light is
    on moves at most 7 blocks, a passing headlight is a one-frame blip the
    median already absorbs). If under `min_stable` of the frames sit in runs
    of at least `min_seg` between steps, it is cloud, and segmentation is off.
    Each frame's median uses only its own segment;
    frames in a segment shorter than `min_seg` (the ramp of a switch) return
    None and are left out of the sweep. The level map is cached as
    `levels_path` so the max and deep runs share one pass.

    Raw frames are held as uint16 (2x2 sums fit), ~6 MB each binned, and the
    median runs in row strips, so 21 frames peak ~480 MB: sized for the 1 GB
    eclipticam Pi."""

    def __init__(self, fs, n_bin, n, levels_path=None, step_adu=10.0, step_blocks=10, min_seg=5,
                 min_stable=0.5):
        self.fs, self.bin, self.n, self.min_seg = fs, n_bin, max(3, n | 1), min_seg
        self.raw = {}
        names = [Path(f).name for f in fs]
        L = None
        if levels_path and Path(levels_path).exists():
            z = np.load(levels_path)
            if list(z["names"]) == names:
                L = z["L"]
        if L is None:
            print(f"background: level pass over {len(fs)} frames", flush=True)
            L = np.array([block_levels(load_bin(f, n_bin)) for f in fs])
            if levels_path:
                np.savez(levels_path, L=L, names=np.array(names))
        thr = step_adu * (n_bin / 2.0) ** 2
        jumps = (np.abs(np.diff(L, axis=0)) > thr).reshape(len(L) - 1, -1).sum(1) >= step_blocks
        seg = np.concatenate([[0], np.cumsum(jumps)])
        stable = sum(c for c in np.bincount(seg) if c >= min_seg) / len(seg)
        if jumps.any() and stable < min_stable:
            # Steps everywhere, no long stable stretches between them: drifting
            # CLOUD, not a light switching (10-08 overcast: 59 steps in 60
            # frames, 0% stable, would have dropped every frame). A switch
            # leaves long stable runs either side (10-07 03 UTC: ~80%).
            # Fall back to the plain running median; the night shows cloud.
            print(f"background: {int(jumps.sum())} level steps, only {stable:.0%} of frames in "
                  f"stable runs: cloud, not glare switches; no segmentation")
            jumps[:] = False
        self.seg = np.concatenate([[0], np.cumsum(jumps)])
        self.bounds = {}
        for sid in np.unique(self.seg):
            k = np.nonzero(self.seg == sid)[0]
            self.bounds[sid] = (int(k[0]), int(k[-1]) + 1)
        short = sum(b - a for a, b in self.bounds.values() if b - a < min_seg)
        print(f"background: {len(self.bounds)} segments ({int(jumps.sum())} glare switches); "
              f"{short} frames in switch ramps left out")

    def _get(self, i):
        if i not in self.raw:
            self.raw[i] = np.clip(load_bin(self.fs[i], self.bin), 0, 65535).astype(np.uint16)
        return self.raw[i]

    def subtracted(self, i):
        a, b = self.bounds[self.seg[i]]
        if b - a < self.min_seg:
            return None
        h = self.n // 2
        lo = min(max(a, i - h), max(a, b - self.n))
        idx = range(lo, min(b, lo + self.n))
        for k in [k for k in self.raw if k < lo]:      # windows advance monotonically
            del self.raw[k]
        frames = [self._get(k) for k in idx]
        out = self._get(i).astype(np.float32)
        H = out.shape[0]
        for r0 in range(0, H, 128):          # row strips: the median's copy stays ~1/10 of the stack
            r1 = min(H, r0 + 128)
            out[r0:r1] -= np.median(np.stack([f[r0:r1] for f in frames]), axis=0)
        # coarse residual sky: whatever the median could not follow within the
        # minute (glare settling after a switch, dawn, moonlight) is smooth, so
        # 48-px block medians, upsampled, take it without touching stars
        b = 48
        h, w = H // b, out.shape[1] // b
        blk = np.median(out[:h * b, :w * b].reshape(h, b, w, b).transpose(0, 2, 1, 3).reshape(h, w, -1)[:, :, ::3], axis=2)
        out -= cv2.resize(cv2.GaussianBlur(blk.astype(np.float32), (3, 3), 0), (out.shape[1], H),
                          interpolation=cv2.INTER_CUBIC)
        return out

def build_fg_mask(fs, n_bin, out, n_med=21, step=6):
    """Foreground mask for a fixed camera, from one clear night (no glare
    switches in the frames given). Two maps:
      S = static scene (median of a frame sample): roofs and trees are dark
          silhouettes against the glowing sky, so the horizon in each column
          is the first point, going down the lower part of the frame, where S
          drops below 0.8 of the brightest sky above it;
      V = typical |running-median residual| per pixel: the sky sits at the
          noise floor, flickering glare well above it, so glare is the
          edge-connected region where V > 1.8x its median.
    Everything below the horizon, plus the glare, is foreground. Written as a
    binary PNG at the binned frame size (255 = foreground). 2026-10-07: 21.6%."""
    from scipy import ndimage as ndi
    rm = RunningMedian(fs, n_bin, n_med)
    V = []
    for i in range(n_med // 2, len(fs) - n_med // 2, step):
        r = rm.subtracted(i)
        if r is not None:
            V.append(np.abs(r))
    V = np.median(np.stack(V), axis=0)
    S = np.median(np.stack([load_bin(fs[i], n_bin) for i in range(0, len(fs), 2 * step)]), axis=0)
    H, W = S.shape
    Ss = cv2.blur(S.astype(np.float32), (7, 7)) - 64.0 * n_bin * n_bin
    top = np.maximum.accumulate(Ss, axis=0)
    dark = (Ss < 0.8 * top) & (np.arange(H)[:, None] > H * 0.45)
    hz = np.array([np.argmax(dark[:, x]) if dark[:, x].any() else H for x in range(W)])
    hz = ndi.minimum_filter1d(ndi.median_filter(hz, 15), 9) - 6
    m = np.arange(H)[:, None] >= hz[None, :]
    Vs = cv2.blur(V.astype(np.float32), (15, 15))
    lab, _ = ndi.label(ndi.binary_dilation(Vs > 1.8 * np.median(Vs), iterations=6))
    edge = np.unique(np.concatenate([lab[-1], lab[:, -1], lab[:, 0]]))
    m |= np.isin(lab, edge[edge > 0])
    cv2.imwrite(str(out), (m * 255).astype(np.uint8))
    print(f"foreground mask -> {out}: {100 * m.mean():.1f}% masked, horizon rows "
          f"p10/50/90 {np.percentile(hz, [10, 50, 90]).astype(int).tolist()}")


def load_fg_mask(path, H, W):
    m = cv2.imread(str(path), cv2.IMREAD_GRAYSCALE)
    if m is None:
        raise SystemExit(f"cannot read foreground mask {path}")
    if m.shape != (H, W):
        m = cv2.resize(m, (W, H), interpolation=cv2.INTER_NEAREST)
    return m > 127


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n", 1)[0])
    ap.add_argument("--camera", default="eclipticam-v3w")
    ap.add_argument("--night", required=True)
    ap.add_argument("--window-min", type=float, default=10.0)
    ap.add_argument("--step-min", type=float, default=1.0)
    ap.add_argument("--mode", choices=("max", "deep"), default="max",
                    help="max: overlap 60s streaks into one bright streak "
                         "(animation). deep: MEAN the registered frames "
                         "then subtract local background — maximum SNR, "
                         "pulls the faintest stars (linear p13-p97.4 "
                         "stretch matching splay).")
    ap.add_argument("--v", type=float, default=None,
                    help="detrans velocity as FRACTION of image width per "
                         "second (default: camera.json detrans.v_frac_per_s)")
    ap.add_argument("--v-px", type=float, default=None,
                    help="detrans velocity in px/sec at the WORKING "
                         "resolution — dev override; bypasses fraction scaling")
    ap.add_argument("--angle", type=float, default=None,
                    help="deg (default: camera.json detrans.angle_deg)")
    ap.add_argument("--k1", type=float, default=None)
    ap.add_argument("--k2", type=float, default=None)
    ap.add_argument("--bin", type=int, default=2,
                    help="n×n sum-bin factor (default 2). Bin>=2 sum-combines "
                         "the RGGB Bayer quad to clean grey BEFORE the warp — "
                         "the correct de-mosaic. bin=1 would geometrically warp "
                         "the raw mosaic (Bayer checkerboard baked in) and is "
                         "auto-promoted to 2. Larger is faster/higher-SNR.")
    ap.add_argument("--allow-mosaic-warp", action="store_true",
                    help="permit --bin 1 (warps the raw Bayer mosaic — "
                         "checkerboard artifacts). For debugging only.")
    ap.add_argument("--bg-median", type=int, default=0, metavar="N",
                    help="subtract a per-pixel running median of N frames (odd, e.g. 21) "
                         "in the camera frame before registering: removes glare, glass "
                         "reflections and the lit foreground; residuals kept signed. "
                         "0 = off (the old behaviour)")
    ap.add_argument("--fg-mask", type=Path, default=None,
                    help="binary PNG (255 = foreground) in the camera frame: those pixels go "
                         "black in the output, carried through undistort and registration")
    ap.add_argument("--build-fg-mask", type=Path, default=None, metavar="PNG",
                    help="build the foreground mask from this night's frames (a clear night, "
                         "no glare switches; restrict with --frames-glob) and exit")
    ap.add_argument("--fps", type=int, default=12)
    ap.add_argument("--max-windows", type=int, default=None,
                    help="process only the first N output frames (slice)")
    ap.add_argument("--out", type=Path, required=True)
    ap.add_argument("--frames-glob", default=None,
                    help="override frame glob (default resolves v3w night)")
    args = ap.parse_args()

    # Never geometrically warp the raw Bayer mosaic (the CFA checkerboard gets
    # baked into the output — see project-bayer-presentation-decision). bin>=2
    # sum-combines the RGGB quad to grey first. Auto-promote bin 1 -> 2 unless
    # explicitly overridden for debugging.
    if args.bin < 2 and not args.allow_mosaic_warp:
        sys.stderr.write("detrans-sweep: --bin 1 would warp the raw Bayer "
                         "mosaic; promoting to --bin 2 (grey). Pass "
                         "--allow-mosaic-warp to override.\n")
        args.bin = 2

    cfg = CameraConfig.load(args.camera)
    # Calibration from camera.json (distortion + detrans blocks), with
    # CLI overrides and the module fallbacks. A camera with no `detrans`
    # block isn't a detrans candidate — skip cleanly so the pipeline can
    # call this unconditionally.
    detr = cfg.get("detrans") or {}
    dist = cfg.get("distortion") or {}
    if not detr and args.v is None and args.v_px is None:
        sys.stderr.write(f"{args.camera} has no `detrans` block in "
                         "camera.json and no --v/--v-px given; skipping "
                         "(not a detrans camera)\n")
        return 0
    # Detrans velocity as a fraction of image width per second. Prefer the
    # resolution-independent config key; fall back to the legacy px/s key
    # (which was fit on the binned 1152-wide geometry) divided by 1152.
    if args.v is not None:
        v_frac = args.v
    elif "v_frac_per_s" in detr:
        v_frac = detr["v_frac_per_s"]
    elif "v_px_per_s" in detr:
        v_frac = detr["v_px_per_s"] / 1152.0     # legacy: fit at 1152-wide
    else:
        v_frac = V_FRAC_PS
    angle = args.angle if args.angle is not None \
        else detr.get("angle_deg", V_ANGLE_DEG)
    k1 = args.k1 if args.k1 is not None else dist.get("k1", K1)
    k2 = args.k2 if args.k2 is not None else dist.get("k2", K2)

    if args.frames_glob:
        fs = glob.glob(args.frames_glob)
    else:
        # legacy percam tree: <root>/night/<night>/v3w/HH/*.fits.fz.
        # Restrict to purely-numeric hour dirs: older nights carry squash
        # derivatives under a "00b"-style dir (holding max/min/sum.fits.fz),
        # which are NOT capture frames and must be excluded from the window.
        base = cfg.frames_root / "night" / args.night / "v3w"
        fs = [p for p in glob.glob(str(base / "*" / "*.fits.fz"))
              if Path(p).parent.name.isdigit()]
    # Drop TORN frames before anything tries to open them. A 0-byte
    # .fits.fz is never a valid capture — it is a write that was in
    # flight when the store went away (eclipticam 2026-08-24T23:50:28Z,
    # 36 s before its USB-SATA link dropped and the SSD re-enumerated;
    # the page write was lost and the file left empty). astropy raises
    # OSError("Empty or corrupt FITS file") on such a file, which used
    # to abort the whole sweep and cost the night its detrans
    # deliverables — while nightly-cam happily stacked the other 263.
    # Skip them, but say so: a silently-dropped frame is how a capture
    # fault gets mistaken for a quiet night.
    torn = [p for p in fs if os.path.getsize(p) == 0]
    if torn:
        fs = [p for p in fs if os.path.getsize(p) > 0]
        sys.stderr.write(
            f"skipping {len(torn)} torn (0-byte) frame(s) — "
            f"incomplete writes, not usable capture:\n")
        for p in torn:
            sys.stderr.write(f"  {p}\n")
    if not fs:
        sys.stderr.write("no frames found\n")
        return 2
    # Sort by TIMESTAMP, not lexically: the night spans 23->00->01->02 UTC
    # and the hour dirs sort 00,01,02,23 — lexical order is non-monotonic
    # in time, which breaks the windowing.
    fs = sorted(fs, key=epoch_ms)
    t0_ms = epoch_ms(fs[0])
    ts = np.array([(epoch_ms(p) - t0_ms) / 1000.0 for p in fs])
    print(f"{len(fs)} frames spanning {ts[-1]/3600:.2f} h")

    win_s = args.window_min * 60
    step_s = args.step_min * 60
    starts = np.arange(0, ts[-1] - win_s, step_s)
    if args.max_windows:
        starts = starts[:args.max_windows]
    print(f"{len(starts)} output frames "
          f"(window {args.window_min}min, step {args.step_min}min)")

    if args.build_fg_mask:
        build_fg_mask(fs, args.bin, args.build_fg_mask, n_med=args.bg_median or 21)
        return 0

    # peek one frame for geometry + map
    H, W = load_bin(fs[0], args.bin).shape
    fg = load_fg_mask(args.fg_mask, H, W) if args.fg_mask else None
    mapx, mapy = undistort_map(H, W, k1, k2)
    a = np.radians(angle)
    dv = np.array([np.cos(a), np.sin(a)])

    # Resolve detrans velocity to px/s at THIS working resolution. --v-px
    # is an explicit px/s override at the working res (dev use); otherwise
    # scale the width-fraction by the actual frame width.
    v = args.v_px if args.v_px is not None else v_frac * W
    print(f"calibration: v={v:.4f} px/s ({v_frac*1e5:.4f}e-5 width/s) "
          f"@ {angle}deg, k1={k1} k2={k2}, {W}x{H} (bin {args.bin})")

    args.out.parent.mkdir(parents=True, exist_ok=True)
    # mode-specific scratch so max + deep runs don't collide
    tmpdir = Path(f"~/tmp/detrans-sweep-frames-{args.mode}").expanduser()
    tmpdir.mkdir(parents=True, exist_ok=True)
    for f in tmpdir.glob("*.png"):
        f.unlink()

    # Cache decoded+undistorted frames lazily — adjacent windows overlap
    # (e.g. 10-min window, 1-min step => ~9/10 frames shared), so caching
    # the active working set avoids re-decoding. Each cached frame is a
    # full binned float array, so the cache MUST be bounded to the frames
    # still reachable, or it grows across the whole night and swaps a 1GB
    # Pi (measured ~440MB+ with the old loose eviction). Windows advance
    # monotonically in time, so once a window is done, any frame before the
    # NEXT window's first frame is dead — evict it (see prune_cache below).
    cache = {}

    rmed = (RunningMedian(fs, args.bin, args.bg_median,
                          levels_path=args.out.parent / f"bg-levels-bin{args.bin}.npz")
            if args.bg_median else None)
    if rmed:
        print(f"background: running median of {rmed.n} frames (camera frame)")

    def get_und(i):
        if i not in cache:
            f = rmed.subtracted(i) if rmed else load_bin(fs[i], args.bin)
            if f is not None and fg is not None:
                f[fg] = np.nan     # NaN spreads through remap/warp/max/mean: the union stays black
            cache[i] = None if f is None else cv2.remap(f, mapx, mapy, cv2.INTER_LINEAR)
        return cache[i]

    def prune_cache(min_keep_idx):
        """Drop cached frames below min_keep_idx (no future window needs them)."""
        for k in [k for k in cache if k < min_keep_idx]:
            del cache[k]

    t_start = time.monotonic()
    for wi, w0 in enumerate(starts):
        w1 = w0 + win_s
        idx = np.where((ts >= w0) & (ts < w1))[0]
        if rmed:              # frames in a glare switch's ramp have no clean background
            idx = np.array([i for i in idx if get_und(i) is not None], dtype=int)
        if len(idx) == 0:
            continue
        wt0 = ts[idx[0]]
        if args.mode == "deep":
            # MEAN the registered frames (noise averages down √N), then
            # subtract the local background → faint stars on a near-zero
            # floor. Linear p13-p97.4 stretch (splay's), tuned for depth.
            acc = np.zeros((H, W), dtype=np.float64)
            for i in idx:
                sh = -v * (ts[i] - wt0) * dv
                M = np.float32([[1, 0, sh[0]], [0, 1, sh[1]]])
                acc += cv2.warpAffine(get_und(i), M, (W, H),
                                      flags=cv2.INTER_LINEAR)
            deep = (acc / len(idx)).astype(np.float32)
            if not rmed:      # the running median already took the background
                deep = local_bg_subtract(deep)
            if rmed:          # signed residuals: black just below zero, asinh as derot-sky
                out8 = stretch_signed_u8(deep)
            else:
                out8 = stretch_u8(deep, lo_pct=13.0, hi_pct=97.4, linear=True)
        else:
            # MAX: overlap the 60s streaks into one bright streak.
            acc = None
            for i in idx:
                sh = -v * (ts[i] - wt0) * dv
                M = np.float32([[1, 0, sh[0]], [0, 1, sh[1]]])
                w = cv2.warpAffine(get_und(i), M, (W, H),
                                   flags=cv2.INTER_LINEAR)
                acc = w if acc is None else np.maximum(acc, w)
            # a max of ~10 noise samples sits ~1.5 sigma up: black one sigma above
            # its median clears that floor, as diff-sweep's --noise-floor-mult does
            out8 = stretch_signed_u8(acc, sig_below=-1.0, hi_pct=99.9) if rmed else stretch_u8(acc)
        # Crop the barrel-undistort black border (per-edge, mode-specific —
        # see CROP_FRAC). Undistorting k1=-0.636 leaves a lens-shaped valid
        # region inside black wedges; a full black-free crop would discard
        # most of the frame, so trim a hand-tuned inset. Fractional =>
        # resolution-independent.
        fl, fr, ft, fb = CROP_FRAC[args.mode]
        ch, cw = out8.shape[:2]
        x0, x1 = int(cw * fl), cw - int(cw * fr)
        y0, y1 = int(ch * ft), ch - int(ch * fb)
        out8 = out8[y0:y1, x0:x1]
        # yuv420p / libx264 needs even dimensions — drop a last row/col if odd.
        out8 = out8[:out8.shape[0] // 2 * 2, :out8.shape[1] // 2 * 2]
        cv2.imwrite(str(tmpdir / f"f{wi:04d}.png"), out8)
        # Bound the cache: the next window starts at starts[wi]+step_s, so any
        # frame before that is no longer reachable — evict it. Keeps the cache
        # to ~one window's worth of frames (the working set), not the whole
        # night. This is what stops the 1GB-Pi swap.
        next_w0 = starts[wi] + step_s
        keep_from = int(np.searchsorted(ts, next_w0, side="left"))
        prune_cache(keep_from)
        if wi % 20 == 0:
            el = time.monotonic() - t_start
            print(f"  {wi+1}/{len(starts)}  {el:.0f}s "
                  f"({el/(wi+1):.2f}s/frame)  cache={len(cache)}", flush=True)

    # encode. x264 preset/threads bound memory (frames held resident) —
    # default medium OOM'd the 1GB Pi. Honour host-aware FFMPEG_PRESET/THREADS
    # from publish-night-cam; default safe.
    _preset = os.environ.get("FFMPEG_PRESET", "veryfast")
    _threads = os.environ.get("FFMPEG_THREADS", "1")
    print("encoding...")
    subprocess.run([
        "ffmpeg", "-y", "-loglevel", "error",
        "-threads", str(_threads), "-framerate", str(args.fps),
        "-i", str(tmpdir / "f%04d.png"),
        "-c:v", "libx264", "-pix_fmt", "yuv420p", "-crf", "20",
        "-preset", _preset,
        str(args.out)], check=True)
    print(f"wrote {args.out} "
          f"({len(starts)} frames, {time.monotonic()-t_start:.0f}s total)")
    return 0


if __name__ == "__main__":
    sys.exit(main())

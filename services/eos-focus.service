[Unit]
Description=EOS 2000D nightly focus-cycle capture (astro-canon; sun-gated, self-recovering)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=peter
Group=peter
WorkingDirectory=/home/peter
# eos-focus-cycle self-gates on the sun (waits for dark, stops at dawn) and
# loops the d-schedule every night; --passes 0 = run forever. Output dir is
# dated per-invocation. On a wedge it recovers (gentle release -> grace window
# -> eos-power 12V cycle as last resort, capped by --power-budget).
# NB: %h expands to the SERVICE MANAGER's home (/root for a system service),
# not User=peter's — so hardcode the path. (astro-canon 2026-07-25.)
ExecStart=/home/peter/bin/eos-focus-cycle --out /home/peter/tmp/canon-focus-nightly
# ~/bin (eos-power) and super/bin (alert) are not on a system service's PATH.
Environment=PATH=/home/peter/bin:/home/peter/super/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Restart=always
# 15 min, not 30s: a normal run exits at dawn and just re-enters wait-for-dark;
# but if the camera is unrecoverable the tool aborts cleanly after N fails, and
# this backoff stops a 63-restarts/night thrash (seen 2026-07-25). Worst case
# ~4 restarts/hour instead of ~120.
RestartSec=900
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

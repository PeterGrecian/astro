[Unit]
Description=astro: fast-forward ~/astro to origin/main (bin/astro-sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=peter
EnvironmentFile=-/etc/default/astro-process
ExecStart=/home/peter/astro/bin/astro-sync
TimeoutStartSec=10min
Nice=10
StandardOutput=journal
StandardError=journal
